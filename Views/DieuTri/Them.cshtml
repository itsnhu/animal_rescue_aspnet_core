@model HeThongCuuHo.Models.HoSoDieuTri

@{
    ViewData["Title"] = "Thêm hồ sơ điều trị";
}

<style>
    /* 1. ĐỒNG BỘ FONT TIMES NEW ROMAN */
    body, h1, h2, h3, h4, h5, h6, .card, .btn, .badge, p, span, div, label, input, select, textarea {
        font-family: 'Times New Roman', Times, serif !important;
    }

    body {
        background-color: #f8fafc;
    }

    .card-custom {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 12px 20px;
    }

    .form-label {
        font-weight: 700;
        color: #334155;
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .form-control-custom {
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        font-size: 0.95rem;
        padding: 6px 12px;
        height: auto;
        transition: all 0.2s;
    }

    .form-control-custom:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
    }

    .btn-action {
        border-radius: 6px;
        font-weight: 700;
        padding: 8px 20px;
        font-size: 0.95rem;
        transition: all 0.2s;
    }
</style>

<div class="container-fluid py-2 px-md-4">
    <div class="row justify-content-center">
        <!-- Mở rộng cột một chút để không bị trống 2 bên -->
        <div class="col-lg-10 col-xl-8">
            
            <div class="card card-custom">
                <!-- HEADER -->
                <div class="card-header-custom">
                    <h4 class="mb-0 font-weight-bold" style="font-size: 1.25rem;">Thêm Hồ Sơ Điều Trị Y Tế</h4>
                    <p class="mb-0 small" style="opacity: 0.85;">Nhập thông tin chi tiết quá trình khám chữa bệnh cho động vật</p>
                </div>

                <!-- BODY FORM -->
                <div class="card-body p-3">
                    <form asp-action="Them" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="font-size: 0.9rem;"></div>

                        <div class="row">
                            <!-- Động vật cần điều trị -->
                            <div class="col-12 mb-2">
                                <label asp-for="MaDongVat" class="form-label">Động vật <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-paw"></i></span>
                                    </div>
                                    <select asp-for="MaDongVat" class="form-control form-control-custom" required>
                                        <option value="">-- Chọn động vật cần điều trị --</option>
                                        @if (ViewBag.DongVat != null)
                                        {
                                            @foreach (var item in ViewBag.DongVat)
                                            {
                                                <option value="@item.MaDongVat" selected="@(Model?.MaDongVat == item.MaDongVat ? "selected" : null)">
                                                    @item.Ten (Mã: @item.MaDongVat - @item.Loai)
                                                </option>
                                            }
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="MaDongVat" class="text-danger small"></span>
                            </div>

                            <!-- Ngày khám & Trạng thái -->
                            <div class="col-md-6 mb-2">
                                <label asp-for="NgayKham" class="form-label">Ngày khám <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                    </div>
                                    <input asp-for="NgayKham" type="date" class="form-control form-control-custom" 
                                           value="@(Model?.NgayKham != default ? Model.NgayKham.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))" required />
                                </div>
                                <span asp-validation-for="NgayKham" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label asp-for="TrangThai" class="form-label">Trạng thái</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-info-circle"></i></span>
                                    </div>
                                    <select asp-for="TrangThai" class="form-control form-control-custom">
                                        <option value="Đang điều trị">Đang điều trị</option>
                                        <option value="Hoàn thành">Hoàn thành</option>
                                        <option value="Tạm dừng">Tạm dừng</option>
                                    </select>
                                </div>
                                <span asp-validation-for="TrangThai" class="text-danger small"></span>
                            </div>

                            <!-- Chẩn đoán -->
                            <div class="col-12 mb-2">
                                <label asp-for="ChanDoan" class="form-label">Chẩn đoán <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-stethoscope"></i></span>
                                    </div>
                                    <input asp-for="ChanDoan" class="form-control form-control-custom" placeholder="Ví dụ: Viêm da, gãy chân..." required />
                                </div>
                                <span asp-validation-for="ChanDoan" class="text-danger small"></span>
                            </div>

                            <!-- Phương pháp & Chi phí -->
                            <div class="col-md-8 mb-2">
                                <label asp-for="DieuTri" class="form-label">Phương pháp / Phác đồ điều trị</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-notes-medical"></i></span>
                                    </div>
                                    <input asp-for="DieuTri" class="form-control form-control-custom" placeholder="Ví dụ: Bôi thuốc, bó bột..." />
                                </div>
                                <span asp-validation-for="DieuTri" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-2">
                                <label asp-for="ChiPhi" class="form-label">Chi phí (VNĐ)</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fas fa-money-bill-wave"></i></span>
                                    </div>
                                    <input asp-for="ChiPhi" type="number" step="1000" class="form-control form-control-custom" placeholder="0" />
                                </div>
                                <span asp-validation-for="ChiPhi" class="text-danger small"></span>
                            </div>

                            <!-- Ghi chú -->
                            <div class="col-12 mb-2">
                                <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text align-items-start pt-2"><i class="fas fa-comment-alt"></i></span>
                                    </div>
                                    <textarea asp-for="GhiChu" class="form-control form-control-custom" rows="2" placeholder="Ghi chú thêm (nếu có)..."></textarea>
                                </div>
                                <span asp-validation-for="GhiChu" class="text-danger small"></span>
                            </div>

                            <!-- Nút thao tác -->
                            <div class="col-12 d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-action">
                                    <i class="fas fa-arrow-left mr-1"></i> Quay lại
                                </a>
                                <button type="submit" class="btn btn-success btn-action shadow-sm">
                                    <i class="fas fa-save mr-1"></i> Lưu Hồ Sơ
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}