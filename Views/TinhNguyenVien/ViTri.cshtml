@model HeThongCuuHo.Models.TinhNguyenVien

@{
    ViewData["Title"] = "Vị trí tình nguyện viên";
}

<!-- Nhúng CSS Leaflet Map & FontAwesome -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* 2. ĐỒNG BỘ FONT TIMES NEW ROMAN TOÀN TRANG */
    body, h1, h2, h3, h4, h5, h6, .card, .btn, p, span, div, label {
        font-family: 'Times New Roman', Times, serif !important;
    }

    body {
        background-color: #f8fafc;
        /* Đã xóa overflow: hidden để cho phép cuộn chuột */
    }

    .card-custom {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        overflow: hidden;
    }

    .card-header-custom {
        background: #ffffff;
        border-bottom: 1px solid #f1f5f9;
        padding: 15px 20px;
    }

    /* 1. TỰ ĐỘNG CO GIÃN BẢN ĐỒ ĐỂ VỪA 1 MÀN HÌNH */
    #map {
        height: calc(100vh - 280px); /* Tăng khoảng trừ lên 280px để chừa không gian cho Header, Footer, Padding */
        min-height: 350px;
        width: 100%;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        z-index: 1;
    }

    .info-block {
        display: inline-flex;
        align-items: center;
        background: #f8fafc;
        padding: 6px 12px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        font-size: 0.9rem;
        color: #334155;
        margin-right: 10px;
        margin-top: 8px;
        font-weight: 600;
    }

    .info-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
    }
    .status-ready { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .status-busy { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
</style>

<div class="container-fluid py-3 px-md-4">
    <div class="card card-custom">
        
        <!-- HEADER: Bố cục thông tin rõ ràng -->
        <div class="card-header-custom d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h4 class="mb-1 font-weight-bold text-dark" style="font-size: 1.25rem;">
                    Vị trí tình nguyện viên: @Model.HoTen
                </h4>
                <div class="d-flex flex-wrap">
                    <span class="info-block">
                        <i class="fas fa-phone-alt text-primary mr-2"></i> @Model.SoDienThoai
                    </span>
                    <span class="info-block">
                        <i class="fas fa-map-marker-alt text-danger mr-2"></i> Tọa độ: @Model.ViDo, @Model.KinhDo
                    </span>
                </div>
            </div>
            <div class="mt-2 mt-md-0">
                @if (Model.TrangThai == "Sẵn sàng")
                {
                    <span class="info-badge status-ready">Sẵn sàng</span>
                }
                else
                {
                    <span class="info-badge status-busy">@Model.TrangThai</span>
                }
            </div>
        </div>

        <!-- BODY: Chứa bản đồ -->
        <div class="card-body p-2">
            <div id="map"></div>
        </div>

        <!-- FOOTER: Nút quay lại -->
        <div class="card-footer bg-white border-top py-2 px-3 d-flex justify-content-end">
            <a asp-action="Index" class="btn btn-outline-secondary font-weight-bold px-4" style="border-radius: 6px;">
                Quay lại danh sách
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        $(document).ready(function () {
            // Lấy tọa độ từ Model
            var lat = @(Model.ViDo != 0 ? Model.ViDo.ToString(System.Globalization.CultureInfo.InvariantCulture) : "10.7769");
            var lng = @(Model.KinhDo != 0 ? Model.KinhDo.ToString(System.Globalization.CultureInfo.InvariantCulture) : "106.7009");

            // Khởi tạo bản đồ
            var map = L.map('map').setView([lat, lng], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            // Thêm marker và popup hiển thị tên
            var marker = L.marker([lat, lng]).addTo(map);
            marker.bindPopup("<div class='text-center'><b>@Model.HoTen</b><br><small>@Model.SoDienThoai</small></div>").openPopup();

            // Bắt buộc bản đồ tính toán lại kích thước để hiển thị đúng
            setTimeout(function(){ map.invalidateSize(); }, 200);
        });
    </script>
}