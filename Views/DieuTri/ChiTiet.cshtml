@model HeThongCuuHo.Models.HoSoDieuTri

@{
    ViewData["Title"] = "Chi tiết hồ sơ điều trị";
}

<style>
    /* 2. ĐỒNG BỘ FONT TIMES NEW ROMAN TOÀN TRANG */
    body, h1, h2, h3, h4, h5, h6, .card, .btn, .badge, p, span, div, label, input, select, textarea {
        font-family: 'Times New Roman', Times, serif !important;
    }

    body {
        background-color: #f8fafc;
    }

    .card-custom {
        max-width: 850px;
        margin: 0 auto;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        color: white;
        padding: 15px 20px;
        border-bottom: none;
    }

    /* 6. THIẾT KẾ LẠI CÁC KHỐI THÔNG TIN ĐỂ GIẢM KHOẢNG TRỐNG */
    .info-row {
        display: flex;
        padding: 10px 0;
        border-bottom: 1px dashed #e2e8f0;
        align-items: flex-start;
    }

    .info-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .info-row:first-child {
        padding-top: 0;
    }

    .info-label {
        width: 150px;
        flex-shrink: 0;
        font-weight: 700;
        color: #64748b;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .info-val {
        flex-grow: 1;
        font-weight: 600;
        color: #1e293b;
        font-size: 1rem;
        word-wrap: break-word;
    }

    .info-val-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 8px 12px;
        border-radius: 6px;
        width: 100%;
        font-weight: 600;
        color: #1e293b;
    }

    /* Trạng thái (Bỏ icon) */
    .badge-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 100px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .status-done { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .status-treating { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }

    /* Nút bấm đồng bộ */
    .btn-action {
        border-radius: 6px;
        font-weight: 700;
        padding: 8px 20px;
        font-size: 0.95rem;
        transition: all 0.2s;
    }
</style>

<div class="container-fluid py-3 px-md-4">
    <div class="card-custom">
        
        <!-- HEADER (3. Bỏ icon) -->
        <div class="card-header-custom d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h4 class="mb-1 font-weight-bold">Chi Tiết Hồ Sơ Điều Trị Y Tế</h4>
                <p class="mb-0 small" style="opacity: 0.85;">Thông tin chi tiết quá trình khám chữa bệnh</p>
            </div>
            <span class="badge badge-light text-primary px-3 py-2 mt-2 mt-md-0" style="font-size: 0.95rem; border-radius: 20px;">
                Mã hồ sơ: @Model.MaHoSo
            </span>
        </div>

        <!-- BODY -->
        <div class="card-body p-3 p-md-4">
            
            <!-- Sử dụng danh sách (info-row) để thông tin xếp sát nhau, không bị loãng -->
            <div class="info-row">
                <!-- 5. Bỏ dấu # -->
                <div class="info-label">Mã hồ sơ</div>
                <div class="info-val text-primary">@Model.MaHoSo</div>
            </div>

            <div class="info-row">
                <div class="info-label">Động vật</div>
                <div class="info-val text-primary">
                    @(Model.DongVat?.Ten ?? "Chưa xác định")
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Ngày điều trị</div>
                <div class="info-val text-muted">
                    @Model.NgayKham.ToString("dd/MM/yyyy")
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Trạng thái</div>
                <div class="info-val">
                    <!-- 4. Bỏ icon ở Trạng thái -->
                    @if (Model.TrangThai == "Hoàn thành" || Model.GhiChu == "Đã khỏi")
                    {
                        <span class="badge-status status-done">Hoàn thành</span>
                    }
                    else
                    {
                        <span class="badge-status status-treating">@(string.IsNullOrEmpty(Model.TrangThai) ? "Đang điều trị" : Model.TrangThai)</span>
                    }
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Chẩn đoán</div>
                <div class="info-val-box">
                    @(string.IsNullOrEmpty(Model.ChanDoan) ? "Chưa có chẩn đoán" : Model.ChanDoan)
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Phác đồ điều trị</div>
                <div class="info-val-box">
                    @(string.IsNullOrEmpty(Model.DieuTri) ? "Chưa có phác đồ" : Model.DieuTri)
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Chi phí</div>
                <div class="info-val text-danger">
                    @(Model.ChiPhi.HasValue ? Model.ChiPhi.Value.ToString("N0") + " VNĐ" : "Chưa cập nhật")
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Ghi chú</div>
                <div class="info-val-box text-muted fst-italic" style="font-weight: normal;">
                    @(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú" : Model.GhiChu)
                </div>
            </div>

            <!-- KHU VỰC NÚT BẤM THAO TÁC -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary btn-action mb-2 mb-sm-0">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
                </a>
                <a asp-action="Sua" asp-route-id="@Model.MaHoSo" class="btn btn-warning btn-action text-dark shadow-sm">
                    <i class="fas fa-pen mr-1"></i> Chỉnh sửa hồ sơ
                </a>
            </div>

        </div>
    </div>
</div>