@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Khôi phục mật khẩu";
}

<style>
    /* 1. ÉP FONT TIMES NEW ROMAN CHO TOÀN BỘ TRANG */
    body, h1, h2, h3, h4, h5, h6, p, span, div, a, input, button, label, i, small {
        font-family: 'Times New Roman', Times, serif !important;
    }

    /* =========================================================================
       2. THU NHỎ CỘT BÊN TRÁI ĐỂ VỪA 1 MÀN HÌNH
       ========================================================================= */
    .login-wrapper {
        height: 100vh !important;
        overflow: hidden !important;
    }
    .login-brand-panel { padding: 1.5rem 2rem !important; }
    .brand-hero-image { margin-bottom: 1rem !important; }
    .brand-hero-image img { width: 180px !important; height: 180px !important; }
    .brand-hero-image::before { width: 196px !important; height: 196px !important; top: -8px !important; }
    .brand-logo { width: 50px !important; height: 50px !important; font-size: 24px !important; margin-bottom: 0.5rem !important; border-radius: 14px !important; }
    .brand-title { font-size: 1.8rem !important; margin-bottom: 0.2rem !important; }
    .brand-subtitle { font-size: 0.85rem !important; line-height: 1.4 !important; margin-bottom: 1rem !important; }
    .brand-features { margin-top: 1rem !important; gap: 0.5rem !important; }
    .brand-feature { padding: 6px 12px !important; font-size: 0.8rem !important; }
    .brand-feature-icon { width: 28px !important; height: 28px !important; font-size: 0.8rem !important; }
    .brand-stats { margin-top: 1rem !important; padding-top: 1rem !important; gap: 1rem !important; }
    .brand-stat-number { font-size: 1.2rem !important; }
    .brand-stat-label { font-size: 0.65rem !important; }

    /* =========================================================================
       3. GIAO DIỆN FORM KHÔI PHỤC (CỘT BÊN PHẢI)
       ========================================================================= */
    .login-form-panel { padding: 1rem !important; }
    
    /* Container bọc form, căn giữa theo chiều dọc */
    .reset-password-container {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        width: 100%;
        max-width: 440px;
        margin: 0 auto;
    }

    /* Card Form */
    .auth-card {
        background: #ffffff !important;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    /* Icon Header */
    .icon-badge {
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, #ecfdf5, #d1fae5);
        color: #10b981;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.15);
    }

    .form-title {
        color: #0f172a !important;
        font-weight: 700 !important; 
        font-size: 1.4rem;
    }

    .form-subtitle {
        color: #64748b;
        font-size: 0.85rem;
    }

    /* Input group */
    .custom-input-group {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #cbd5e1;
        transition: all 0.2s ease;
        background: #f8fafc;
        display: flex;
        align-items: center;
    }

    .custom-input-group:focus-within {
        border-color: #10b981;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }

    .custom-input-group .input-group-text {
        background-color: transparent;
        border: none;
        color: #059669;
        padding-left: 12px;
        padding-right: 8px;
        font-size: 0.9rem;
    }

    .custom-input-group .form-control {
        border: none;
        padding: 10px 12px 10px 0;
        font-size: 0.95rem;
        color: #1e293b;
        background: transparent;
        height: 42px;
    }

    .custom-input-group .form-control:focus {
        box-shadow: none;
        background: transparent;
    }

    /* Input OTP cách điệu */
    .otp-input {
        letter-spacing: 6px;
        font-size: 1.2rem;
        font-weight: 700;
        text-align: center;
        color: #059669;
    }

    /* Nút bấm */
    .btn-success-custom {
        background: linear-gradient(135deg, #10b981, #059669);
        border: none;
        color: #ffffff;
        font-weight: 700;
        border-radius: 8px;
        padding: 10px;
        width: 100%;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    .btn-success-custom:hover {
        background: linear-gradient(135deg, #059669, #047857);
        transform: translateY(-1px);
    }

    .back-link {
        color: #059669;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.85rem;
    }

    .back-link:hover {
        text-decoration: underline;
    }
</style>

<!-- Nội dung Form bên phải -->
<div class="reset-password-container">
    <div class="card auth-card">
        <div class="card-body p-4">
            
            <!-- Icon & Header -->
            <div class="text-center mb-4">
                <div class="icon-badge mb-2">
                    <i class="fas fa-key"></i>
                </div>
                <h3 class="form-title mb-1">Đặt lại mật khẩu</h3>
                <p class="form-subtitle mb-0">Nhập email đăng ký để nhận mã xác thực OTP</p>
            </div>

            @if (ViewBag.Loi != null)
            {
                <div class="alert alert-danger rounded-2 py-2 px-3 small mb-3" style="font-size: 0.85rem;">
                    <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Loi
                </div>
            }

            @if (ViewBag.ThongBao != null)
            {
                <div class="alert alert-success rounded-2 py-2 px-3 small mb-3" style="font-size: 0.85rem;">
                    <i class="fas fa-check-circle me-1"></i> @ViewBag.ThongBao
                </div>
            }

            <!-- BƯỚC 1: NHẬP EMAIL & GỬI OTP -->
            <div id="step1">
                <form id="formSendOtp">
                    <!-- Tên đăng nhập -->
                    <div class="custom-input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input type="text" id="tenDangNhap" name="tenDangNhap" class="form-control" placeholder="Tên đăng nhập" autocomplete="username" required />
                    </div>

                    <!-- Email -->
                    <div class="custom-input-group mb-4">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" id="email" name="email" class="form-control" placeholder="Địa chỉ Email" autocomplete="email" required />
                    </div>

                    <button type="button" class="btn btn-success-custom" onclick="sendOTP()">
                        <i class="fas fa-paper-plane me-1"></i>GỬI MÃ OTP
                    </button>
                </form>
            </div>

            <!-- BƯỚC 2: NHẬP OTP & MẬT KHẨU MỚI (Ẩn mặc định) -->
            <div id="step2" style="display: none;">
                <form asp-action="QuenMatKhau" method="post">
                    <input type="hidden" id="hiddenUsername" name="tenDangNhap" />
                    <input type="hidden" id="hiddenEmail" name="email" />

                    <!-- Ô Nhập Mã OTP -->
                    <div class="custom-input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-shield-alt"></i></span>
                        <input type="text" name="maOTP" class="form-control otp-input" placeholder="------" maxlength="6" required />
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="custom-input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input type="password" id="password" name="matKhauMoi" class="form-control" placeholder="Mật khẩu mới" autocomplete="new-password" required />
                    </div>

                    <!-- Xác nhận mật khẩu -->
                    <div class="custom-input-group mb-2">
                        <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                        <input type="password" id="confirm" name="xacNhanMatKhau" class="form-control" placeholder="Xác nhận mật khẩu mới" autocomplete="new-password" required />
                    </div>

                    <div class="mb-3 text-start" style="min-height: 20px;">
                        <span id="message" class="text-danger small fw-semibold"></span>
                    </div>

                    <!-- Nút Đổi Mật Khẩu -->
                    <button type="submit" class="btn btn-success-custom mb-3">
                        <i class="fas fa-sync-alt me-1"></i>XÁC NHẬN ĐỔI MẬT KHẨU
                    </button>

                    <!-- Đếm ngược gửi lại OTP -->
                    <div class="text-center mb-2">
                        <span class="small text-muted" id="timerText">Gửi lại mã sau <strong id="timer">60</strong>s</span>
                        <button type="button" id="btnResend" class="btn btn-link btn-sm p-0 text-decoration-none text-success fw-bold" style="display:none;" onclick="sendOTP()">
                            Gửi lại mã OTP
                        </button>
                    </div>
                </form>
            </div>

            <hr class="my-3" style="border-color: #e2e8f0; opacity: 0.6;" />

            <!-- Quay về Đăng nhập -->
            <div class="text-center">
                <a asp-action="Index" class="back-link">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại trang đăng nhập
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    const pass = document.getElementById("password");
    const confirm = document.getElementById("confirm");
    const msg = document.getElementById("message");

    if (confirm && pass) {
        confirm.onkeyup = function () {
            if (pass.value !== confirm.value) {
                msg.innerHTML = "❌ Mật khẩu xác nhận chưa khớp";
            } else {
                msg.innerHTML = "";
            }
        };
    }

    function sendOTP() {
        const username = document.getElementById("tenDangNhap").value.trim();
        const email = document.getElementById("email").value.trim();

        if (!username || !email) {
            alert("Vui lòng nhập đầy đủ Tên đăng nhập và Email!");
            return;
        }

        const btnSend = document.querySelector("#step1 button");
        if(btnSend) btnSend.disabled = true;

        fetch('/Login/GuiMaOTP', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                tenDangNhap: username,
                email: email
            })
        })
        .then(response => response.json())
        .then(data => {
            if(btnSend) btnSend.disabled = false;

            if (data.success) {
                document.getElementById("hiddenUsername").value = username;
                document.getElementById("hiddenEmail").value = email;

                document.getElementById("step1").style.display = "none";
                document.getElementById("step2").style.display = "block";

                startTimer(60);
                
                alert("Mã OTP đã được gửi đến email của bạn!");
            } else {
                alert(data.message || "Có lỗi xảy ra, vui lòng kiểm tra lại thông tin!");
            }
        })
        .catch(error => {
            if(btnSend) btnSend.disabled = false;
            console.error('Error:', error);
            alert("Không thể kết nối đến máy chủ. Vui lòng thử lại sau!");
        });
    }

    function startTimer(seconds) {
        let count = seconds;
        const timerText = document.getElementById("timerText");
        const timerSpan = document.getElementById("timer");
        const btnResend = document.getElementById("btnResend");

        timerText.style.display = "inline";
        btnResend.style.display = "none";
        timerSpan.innerText = count;

        const interval = setInterval(() => {
            count--;
            timerSpan.innerText = count;
            if (count <= 0) {
                clearInterval(interval);
                timerText.style.display = "none";
                btnResend.style.display = "inline";
            }
        }, 1000);
    }
</script>
}