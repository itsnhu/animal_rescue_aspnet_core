@model HeThongCuuHo.Models.LuuTru

@{
    ViewData["Title"] = "Sửa thông tin lưu trú";
}

<style>
    /* 2. ĐỒNG BỘ FONT TIMES NEW ROMAN TOÀN TRANG */
    body, h1, h2, h3, h4, h5, h6, .card, .btn, .badge, p, span, div, label, input, select, textarea {
        font-family: 'Times New Roman', Times, serif !important;
    }

    body {
        background-color: #f8fafc;
    }

    .card-custom {
        max-width: 850px;
        margin: 0 auto;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        color: white;
        padding: 15px 20px;
        border-bottom: none;
    }

    /* 1 & 4. THU GỌN FORM VÀ KHẮC PHỤC KHOẢNG TRỐNG */
    .form-group {
        margin-bottom: 12px;
    }

    .form-label {
        font-weight: 700;
        color: #334155;
        font-size: 0.95rem;
        margin-bottom: 4px;
        display: block;
    }

    .form-control-custom {
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        font-size: 0.95rem;
        padding: 8px 12px;
        height: auto;
        transition: all 0.2s;
    }

    .form-control-custom:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
    }

    /* Nút bấm đồng bộ */
    .btn-action {
        border-radius: 6px;
        font-weight: 700;
        padding: 8px 20px;
        font-size: 0.95rem;
        transition: all 0.2s;
    }
</style>

<div class="container-fluid py-3 px-md-4">
    <div class="card-custom">
        
        <!-- HEADER (3. Sửa badge Mã Lưu Trú, bỏ dấu #) -->
        <div class="card-header-custom d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h4 class="mb-1 font-weight-bold" style="font-size: 1.25rem;">Sửa Thông Tin Lưu Trú</h4>
                <p class="mb-0 small" style="opacity: 0.85;">Cập nhật thông tin phân bổ lưu trú của động vật tại trạm cứu hộ</p>
            </div>
            <span class="badge badge-light text-primary px-3 py-2 mt-2 mt-md-0" style="font-size: 0.95rem; border-radius: 20px; font-weight: 700;">
                Mã Lưu Trú: @Model.MaLuuTru
            </span>
        </div>

        <!-- BODY FORM -->
        <div class="card-body p-3 p-md-4">
            <form asp-action="Sua" method="post">
                <!-- ID ẩn để truyền mã lưu trú về Controller -->
                <input asp-for="MaLuuTru" type="hidden" />

                <div class="row">
                    <!-- Động vật (Full chiều ngang) -->
                    <div class="col-12 form-group">
                        <label asp-for="MaDongVat" class="form-label">
                            Động vật <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MaDongVat"
                                asp-items="@(new SelectList(ViewBag.DongVat, "MaDongVat", "Ten", Model.MaDongVat))"
                                class="form-control form-control-custom" required>
                            <option value="">-- Chọn động vật --</option>
                        </select>
                        <span asp-validation-for="MaDongVat" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Trạm cứu hộ (Nửa trái) -->
                    <div class="col-md-6 form-group">
                        <label asp-for="MaTram" class="form-label">
                            Trạm cứu hộ <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MaTram"
                                asp-items="@(new SelectList(ViewBag.Tram, "MaTram", "TenTram", Model.MaTram))"
                                class="form-control form-control-custom" required>
                            <option value="">-- Chọn trạm cứu hộ --</option>
                        </select>
                        <span asp-validation-for="MaTram" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Ngày bắt đầu (Nửa phải) -->
                    <div class="col-md-6 form-group">
                        <label asp-for="NgayBatDau" class="form-label">
                            Ngày bắt đầu <span class="text-danger">*</span>
                        </label>
                        <input asp-for="NgayBatDau" type="date" class="form-control form-control-custom" value="@Model.NgayBatDau.ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="NgayBatDau" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Ghi chú (Full chiều ngang) -->
                    <div class="col-12 form-group">
                        <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                        <textarea asp-for="GhiChu" class="form-control form-control-custom" rows="3" placeholder="Nhập ghi chú hoặc tình trạng lưu trú..."></textarea>
                        <span asp-validation-for="GhiChu" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <!-- Khu vực nút bấm -->
                <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-action">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
                    </a>
                    <button type="submit" class="btn btn-primary btn-action shadow-sm" style="background-color: #0284c7; border-color: #0284c7;">
                        <i class="fas fa-save mr-1"></i> Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}