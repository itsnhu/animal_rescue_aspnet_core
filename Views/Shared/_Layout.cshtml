@{
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var vaiTro = Context.Session.GetString("VaiTro");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Hệ thống cứu hộ động vật</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HeThongCuuHo.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
        body {
            margin: 0;
            background: #f4f6f9;
            font-family: Arial;
        }
        .sidebar {
            position: fixed;
            width: 250px;
            height: 100vh;
            background: #198754;
            color: white;
        }
        .logo {
            text-align: center;
            padding: 20px;
            font-size: 22px;
            font-weight: bold;
            border-bottom: 1px solid rgba(255,255,255,.2);
        }
        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 15px 20px;
            transition: .3s;
        }
        .sidebar a:hover {
            background: #157347;
        }
        .content {
            margin-left: 250px;
            padding: 20px;
        }
        .topbar {
            background: white;
            padding: 15px 25px;
            border-bottom: 1px solid #ddd;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }
        .notification {
            position: relative;
            cursor: pointer;
            font-size: 26px;
            color: #555;
        }
        .notification:hover {
            color: #198754;
        }
        .badge-notify {
            position: absolute;
            top: -6px;
            right: -10px;
            background: red;
            color: white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 12px;
            font-weight: bold;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo">
            🐶 CỨU HỘ ĐỘNG VẬT
        </div>
        <div style="padding:15px;color:white;border-bottom:1px solid rgba(255,255,255,.2);">
            <b>@tenDangNhap</b>
            <br />
            <small>@vaiTro</small>
        </div>

        <a asp-controller="Home" asp-action="Index">🏠 Trang chủ</a>
        <a asp-controller="BaoCao" asp-action="Index">📢 Báo cáo</a>
        <a asp-controller="DongVat" asp-action="Index">🐶 Động vật</a>
        <a asp-controller="NhanNuoi" asp-action="Index">❤️ Nhận nuôi</a>

        @if (vaiTro == "Admin" || vaiTro == "TinhNguyenVien")
        {
            <a asp-controller="CuuHo" asp-action="Index">🚑 Cứu hộ</a>
            <a asp-controller="DieuTri" asp-action="Index">💉 Điều trị</a>
            <a asp-controller="LuuTru" asp-action="Index">🏠 Lưu trú</a>
        }

        @if (vaiTro == "Admin")
        {
            <a asp-controller="TinhNguyenVien" asp-action="Index">👥 Tình nguyện viên</a>
            <a asp-controller="QuanTri" asp-action="Index">⚙ Quản trị</a>
            <a asp-controller="NhatKy" asp-action="Index"> 📋 Nhật ký hoạt động</a>
        }
        <a asp-controller="Login" asp-action="Logout">🚪 Đăng xuất</a>
    </div>

    <!-- Nội dung -->
    <div class="content">
        <div class="topbar">
            <h3>@ViewData["Title"]</h3>
            <div class="user-info">
                <div class="notification dropdown">
                    <a href="#" id="btnThongBao" data-bs-toggle="dropdown" style="color:inherit;text-decoration:none;">
                        <i class="fas fa-bell"></i>
                        <span class="badge-notify" id="badgeThongBao">0</span>
                    </a>

                    <!-- Đã sửa: Gom gọn thành 1 thẻ ul duy nhất đúng chuẩn HTML -->
                    <ul class="dropdown-menu dropdown-menu-end shadow" id="menuThongBao" style="width:350px;">
                        <li class="dropdown-header fw-bold">Thông báo mới</li>
                        <li><hr class="dropdown-divider my-1"></li>
                        
                        <!-- Khu vực chứa danh sách đổ từ AJAX -->
                        <div id="dsThongBao" style="max-height: 300px; overflow-y: auto;">
                            <!-- Items load ở đây -->
                        </div>

                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item text-center text-success fw-bold" asp-controller="ThongBao" asp-action="Index">
                                Xem tất cả
                            </a>
                        </li>
                    </ul>
                </div>

                <div>
                    <b>@tenDangNhap</b>
                    <br />
                    <small>@vaiTro</small>
                </div>
            </div>
        </div>

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        async function loadThongBao() {
            try {
                const response = await fetch('/ThongBao/DemChuaDoc');
                const count = await response.text();
                const badge = document.getElementById("badgeThongBao");

                if (badge) {
                    badge.innerHTML = count;

                    const badge = document.getElementById("badgeThongBao");

                if(count=="0") {
                    badge.style.display="none";
                    } else {
                        badge.style.display = "flex";
                    }
                }
            } catch (e) {
                console.log("Lỗi đếm thông báo:", e);
            }
        }

        async function loadDanhSachThongBao() {
            try {
                const response = await fetch('/ThongBao/LayThongBaoMoi');
                const data = await response.json();
                let html = "";

                if (!data || data.length === 0) {
                    html = `<div class="text-center text-muted p-3 small">Không có thông báo mới</div>`;
                } else {
                    data.forEach(tb => {
                        // Thêm class đổi màu nền nhẹ nếu chưa đọc
                        let unreadBg = tb.daDoc ? "" : "bg-light";
                        let fontBold = tb.daDoc ? "" : "fw-bold";

                        html += `
                        <li>
                            <a class="dropdown-item py-2 px-3 ${unreadBg}" href="/ThongBao/DaDoc/${tb.maThongBao}">
                                <div class="${fontBold} text-wrap text-dark" style="font-size: 14px;">${tb.noiDung}</div>
                                <small class="text-muted" style="font-size: 11px;"><i class="far fa-clock me-1"></i>${tb.ngayGui}</small>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-0"></li>`;
                    });
                }

                document.getElementById("dsThongBao").innerHTML = html;
            } catch (e) {
                console.log("Lỗi tải danh sách thông báo:", e);
            }
        }

        // Chạy ngay khi tải trang lần đầu
        document.addEventListener("DOMContentLoaded", function () {
            loadThongBao();
            loadDanhSachThongBao();
        });

        // Thiết lập tự động làm mới ngầm mỗi 10 giây (hoặc chỉnh lại theo ý muốn)
        setInterval(function () {
            loadThongBao();
            loadDanhSachThongBao();
        }, 10000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>