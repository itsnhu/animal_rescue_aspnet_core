@model HeThongCuuHo.Models.LuuTru

@{
    ViewData["Title"] = "Chi tiết lưu trú";
}

<style>
    /* 1. ĐỒNG BỘ FONT TIMES NEW ROMAN TOÀN TRANG */
    body, h1, h2, h3, h4, h5, h6, .card, .btn, .badge, p, span, div, label, input, select, textarea {
        font-family: 'Times New Roman', Times, serif !important;
    }

    body {
        background-color: #f8fafc;
    }

    .card-custom {
        max-width: 850px;
        margin: 0 auto;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        overflow: hidden;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
        color: white;
        padding: 15px 20px;
        border-bottom: none;
    }

    /* 5. THIẾT KẾ LẠI CÁC KHỐI THÔNG TIN ĐỂ GIẢM KHOẢNG TRỐNG */
    .info-row {
        display: flex;
        padding: 10px 0;
        border-bottom: 1px dashed #e2e8f0;
        align-items: flex-start;
    }

    .info-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .info-row:first-child {
        padding-top: 0;
    }

    .info-label {
        width: 150px;
        flex-shrink: 0;
        font-weight: 700;
        color: #64748b;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .info-val {
        flex-grow: 1;
        font-weight: 600;
        color: #1e293b;
        font-size: 1rem;
        word-wrap: break-word;
    }

    .info-val-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 8px 12px;
        border-radius: 6px;
        width: 100%;
        font-weight: 600;
        color: #1e293b;
    }

    /* Trạng thái (Bỏ icon) */
    .badge-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 100px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .status-active { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .status-done { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }

    /* Nút bấm đồng bộ */
    .btn-action {
        border-radius: 6px;
        font-weight: 700;
        padding: 8px 20px;
        font-size: 0.95rem;
        transition: all 0.2s;
    }
</style>

<div class="container-fluid py-3 px-md-4">
    <div class="card-custom">
        
        <!-- HEADER -->
        <div class="card-header-custom d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h4 class="mb-1 font-weight-bold">Chi Tiết Lưu Trú</h4>
                <p class="mb-0 small" style="opacity: 0.85;">Thông tin chi tiết đợt lưu trú của động vật tại trạm cứu hộ</p>
            </div>
            <!-- 3. Bỏ dấu # -->
            <span class="badge badge-light text-primary px-3 py-2 mt-2 mt-md-0" style="font-size: 0.95rem; border-radius: 20px; font-weight: 700;">
                Mã lưu trú: @Model.MaLuuTru
            </span>
        </div>

        <!-- BODY -->
        <div class="card-body p-3 p-md-4">
            
            <!-- Danh sách thông tin chi tiết -->
            <div class="info-row">
                <div class="info-label">Động vật</div>
                <div class="info-val text-primary">
                    @(Model.DongVat?.Ten ?? "Chưa đặt tên")
                    @if (Model.DongVat != null)
                    {
                        <span class="text-muted fw-normal" style="font-size: 0.9rem;"> (Loài: @Model.DongVat.Loai)</span>
                    }
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Trạm cứu hộ</div>
                <div class="info-val">
                    @(Model.TramCuuHo?.TenTram ?? "Chưa cập nhật")
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Ngày bắt đầu</div>
                <div class="info-val text-muted">
                    @Model.NgayBatDau.ToString("dd/MM/yyyy")
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Ngày kết thúc</div>
                <div class="info-val text-muted">
                    @(Model.NgayKetThuc.HasValue ? Model.NgayKetThuc.Value.ToString("dd/MM/yyyy") : "Đang lưu trú")
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Trạng thái</div>
                <div class="info-val">
                    <!-- 4. Bỏ icon ở Trạng thái -->
                    @if (Model.TrangThai == "Đang lưu trú")
                    {
                        <span class="badge-status status-active">@Model.TrangThai</span>
                    }
                    else
                    {
                        <span class="badge-status status-done">@Model.TrangThai</span>
                    }
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">Ghi chú</div>
                <div class="info-val-box text-muted fst-italic" style="font-weight: normal;">
                    @(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú thêm." : Model.GhiChu)
                </div>
            </div>

            <!-- KHU VỰC NÚT BẤM THAO TÁC -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary btn-action mb-2 mb-sm-0">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
                </a>
                <a asp-action="Sua" asp-route-id="@Model.MaLuuTru" class="btn btn-primary btn-action shadow-sm" style="background-color: #0284c7; border-color: #0284c7;">
                    <i class="fas fa-pen mr-1"></i> Chỉnh Sửa
                </a>
            </div>

        </div>
    </div>
</div>