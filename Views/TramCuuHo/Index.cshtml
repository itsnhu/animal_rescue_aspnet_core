@model IEnumerable<HeThongCuuHo.Models.TramCuuHo>

@{
    ViewData["Title"] = "Quản lý Trạm cứu hộ";
}

<h2>Quản lý Trạm cứu hộ</h2>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">
        @TempData["ThongBao"]
    </div>
}

<form method="get" class="row mb-3">

    <div class="col-md-8">

        <input type="text"
               name="tuKhoa"
               value="@ViewBag.TuKhoa"
               class="form-control"
               placeholder="Tên trạm hoặc địa chỉ..." />

    </div>

    <div class="col-md-2">

        <button class="btn btn-success w-100">
            Tìm kiếm
        </button>

    </div>

    <div class="col-md-2">

        <a asp-action="Them"
           class="btn btn-primary w-100">

            Thêm mới

        </a>

    </div>

</form>

<table class="table table-bordered table-hover">

    <thead class="table-dark">

        <tr>

            <th>Mã</th>

            <th>Tên trạm</th>

            <th>Địa chỉ</th>

            <th>SĐT</th>

            <th>Sức chứa</th>

            <th>Động vật</th>

            <th>Còn trống</th>

            <th>Thao tác</th>

        </tr>

    </thead>

    <tbody>

@foreach(var item in Model)
{
    int soLuong = item.DongVats?.Count ?? 0;

    int conTrong = item.SucChua - soLuong;

    <tr>

        <td>@item.MaTram</td>

        <td>@item.TenTram</td>

        <td>@item.DiaChi</td>

        <td>@item.SoDienThoai</td>

        <td>@item.SucChua</td>

        <td>

            <span class="badge bg-primary">

                @soLuong

            </span>

        </td>

        <td>

            <span class="badge bg-success">

                @conTrong

            </span>

        </td>

        <td>

            <a asp-action="ChiTiet"
               asp-route-id="@item.MaTram"
               class="btn btn-info btn-sm">

                Chi tiết

            </a>

            <a asp-action="Sua"
               asp-route-id="@item.MaTram"
               class="btn btn-warning btn-sm">

                Sửa

            </a>

        </td>

    </tr>
}

    </tbody>

</table>