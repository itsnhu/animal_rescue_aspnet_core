    <!-- SCRIPT SECTION -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // Init map
        document.addEventListener('DOMContentLoaded', () => {
            const mapEl = document.getElementById('shelterMap');
            if (mapEl) {
                const map = L.map('shelterMap', {
                    scrollWheelZoom: false
                }).setView([21.0285, 105.8542], 14);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);

                const customIcon = L.divIcon({
                    className: 'custom-map-marker',
                    html: '<div style="background-color: var(--ri-navy, #1e293b); color: #f59e0b; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.3); border: 2px solid white;"><i class="fas fa-paw"></i></div>',
                    iconSize: [36, 36],
                    iconAnchor: [18, 18]
                });

                L.marker([21.0285, 105.8542], { icon: customIcon })
                    .addTo(map)
                    .bindPopup('<b>Trạm Cứu Hộ RescuePets</b><br>Số 88 Đường Cứu Trợ, Hà Nội<br><i>Mở cửa 8h30 - 17h30</i>')
                    .openPopup();
            }

            // Scroll effect for back-to-top button
            const backTop = document.getElementById('backToTopBtn');
            window.addEventListener('scroll', () => {
                if (backTop) {
                    if (window.scrollY > 250) {
                        backTop.classList.add('show');
                    } else {
                        backTop.classList.remove('show');
                    }
                }
            });
        });

        // Filter Pets
        function filterPets(category, btn) {
            document.querySelectorAll('.btn-filter-ri').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const cards = document.querySelectorAll('.pet-card-wrapper');
            cards.forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Search Pets
        function searchPets() {
            const query = document.getElementById('petSearchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.pet-card-wrapper');

            cards.forEach(card => {
                const name = card.dataset.name.toLowerCase();
                if (name.includes(query)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Toggle More Pets
        let isMorePetsShown = false;
        function toggleMorePets() {
            isMorePetsShown = !isMorePetsShown;
            const extraCards = document.querySelectorAll('.extra-card');
            extraCards.forEach(c => c.classList.toggle('d-none', !isMorePetsShown));
            const icon = document.getElementById('iconToggleMore');
            if (icon) {
                icon.className = isMorePetsShown ? 'fas fa-minus' : 'fas fa-plus';
            }
            if (isMorePetsShown) {
                showToast('🐾 Đã mở rộng danh sách thú cưng!');
            }
        }

        // View Pet Modal (support openPetModal & viewPet)
        function openPetModal(name, loai, giong, sex, age, weight, health, img, id) {
            document.getElementById('modalPetName').innerText = name || '';
            document.getElementById('modalPetNameDisplay').innerText = name || '';
            document.getElementById('modalPetLoai').innerText = loai || '';
            document.getElementById('modalPetGiong').innerText = giong || '';
            document.getElementById('modalPetSex').innerText = sex || '';
            document.getElementById('modalPetAge').innerText = (age ? (typeof age === 'number' ? age + ' tuổi' : age) : '');
            document.getElementById('modalPetHealth').innerText = 'Tình trạng: ' + (health || 'Khỏe mạnh');
            document.getElementById('modalPetImg').src = img || '/images/pet_teddy.jpg';

            document.getElementById('btnGoToAdoptForm').onclick = function () {
                const modalEl = document.getElementById('petDetailModal');
                const instance = bootstrap.Modal.getInstance(modalEl);
                if (instance) instance.hide();
                openAdoptForm(id || 1, name);
            };

            new bootstrap.Modal(document.getElementById('petDetailModal')).show();
        }

        function viewPet(id, name, loai, giong, sex, age, health, img) {
            openPetModal(name, loai, giong, sex, age, '', health, img, id);
        }

        // Adopt Modal (support openAdoptForm & openAdoptModal)
        function openAdoptForm(id, name) {
            document.getElementById('adoptTargetPetId').value = id || 1;
            document.getElementById('adoptTargetPetName').innerText = name || 'Bé Cưng';
            document.getElementById('adoptSubmitForm').classList.remove('d-none');
            document.getElementById('adoptSuccessState').classList.add('d-none');
            new bootstrap.Modal(document.getElementById('adoptFormModal')).show();
        }

        function openAdoptModal(id, name) {
            openAdoptForm(id, name);
        }

        function submitAdoptForm(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitAdoptNow');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang gửi...';

            const payload = {
                MaDongVat: parseInt(document.getElementById('adoptTargetPetId').value) || 1,
                HoTen: document.getElementById('adoptFullName').value,
                SoDienThoai: document.getElementById('adoptPhone').value,
                Email: document.getElementById('adoptEmail').value,
                DiaChi: document.getElementById('adoptAddress').value,
                LyDo: document.getElementById('adoptReason').value,
                KinhNghiem: ''
            };

            fetch('/Home/GuiDonNhanNuoiAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<span>Gửi Đơn Đăng Ký 🎉</span>';
                if (data.success) {
                    document.getElementById('adoptSubmitForm').classList.add('d-none');
                    document.getElementById('adoptSuccessState').classList.remove('d-none');
                    showToast('🎉 Đơn nhận nuôi của bạn đã được gửi thành công!');
                } else {
                    showToast('❌ ' + (data.message || 'Có lỗi xảy ra!'));
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerHTML = '<span>Gửi Đơn Đăng Ký 🎉</span>';
                showToast('❌ Lỗi kết nối, vui lòng thử lại!');
            });
        }

        // Handle Newsletter Subscription
        function handleNewsletter() {
            const emailInput = document.getElementById('newsletterEmail');
            const email = emailInput.value.trim();
            const sendBtn = document.querySelector('.btn-ri-newsletter-send');

            if (!email) {
                showToast('⚠️ Vui lòng nhập địa chỉ email của bạn!');
                return;
            }

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailRegex.test(email)) {
                showToast('⚠️ Địa chỉ email không hợp lệ!');
                return;
            }

            sendBtn.disabled = true;
            sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            fetch('/Home/SubscribeNewsletter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Email: email })
            })
            .then(res => res.json())
            .then(data => {
                sendBtn.disabled = false;
                sendBtn.innerHTML = '<i class="fas fa-paw"></i>';
                if (data.success) {
                    emailInput.value = '';
                    showToast('🎉 Đăng ký thành công!');
                } else {
                    showToast('❌ ' + (data.message || 'Có lỗi xảy ra!'));
                }
            })
            .catch(err => {
                sendBtn.disabled = false;
                sendBtn.innerHTML = '<i class="fas fa-paw"></i>';
                showToast('❌ Không thể kết nối server, vui lòng thử lại sau!');
            });
        }

        // Format số tiền: tự động hiển thị dấu chấm phân cách hàng nghìn
        function formatDonationInput(input) {
            let raw = input.value.replace(/\D/g, '');
            if (raw) {
                input.value = Number(raw).toLocaleString('vi-VN');
            } else {
                input.value = '';
            }
        }

        function setDonationAmt(amt) {
            document.getElementById('donationAmtInput').value = amt.toLocaleString('vi-VN');
            document.querySelectorAll('.btn-amt').forEach(b => b.classList.remove('active', 'btn-dark'));
            if (window.event && window.event.target) {
                window.event.target.classList.add('active', 'btn-dark');
            }
        }

        function openVietQrModal() {
            const name = document.getElementById('donorName').value.trim();
            const contact = document.getElementById('donorContact').value.trim();

            if (!name) {
                showToast('⚠️ Vui lòng nhập Họ và tên của bạn!');
                document.getElementById('donorName').focus();
                return;
            }
            if (!contact) {
                showToast('⚠️ Vui lòng nhập Số điện thoại hoặc Email!');
                document.getElementById('donorContact').focus();
                return;
            }

            const amtInput = document.getElementById('donationAmtInput');
            const rawAmt = (amtInput.value || '').replace(/\D/g, '');
            const donationAmt = parseInt(rawAmt) || 0;
            const memo = encodeURIComponent(`RESCUEPETS UNG HO - ${name}`);

            // Tạo URL VietQR với STK 838226969 MBBank (mã bin 970422)
            let qrUrl = `https://api.vietqr.io/image/970422-838226969-compact2.jpg?addInfo=${memo}`;
            if (donationAmt > 0) {
                qrUrl += `&amount=${donationAmt}`;
                document.getElementById('qrAmountDisplay').innerText = donationAmt.toLocaleString('vi-VN') + ' VNĐ';
            } else {
                document.getElementById('qrAmountDisplay').innerText = 'Tùy tâm (tự nhập khi chuyển)';
            }

            document.getElementById('vietQrImg').src = qrUrl;
            new bootstrap.Modal(document.getElementById('donationPayModal')).show();

            // Gửi email cảm ơn tự động nếu người dùng nhập Email
            fetch('/Home/GuiEmailUngHo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    HoTen: name,
                    LienHe: contact,
                    SoTien: donationAmt
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success && data.isEmail) {
                    showToast('❤️ Thư cảm ơn đã được gửi đến email: ' + contact);
                }
            })
            .catch(err => {
                console.error('Lỗi gửi email cảm ơn:', err);
            });
        }

        function confirmDonationDone() {
            bootstrap.Modal.getInstance(document.getElementById('donationPayModal')).hide();
            showToast('❤️ Cảm ơn tấm lòng nhân ái của bạn!');
        }

        // ===== NEWS DETAIL MODAL =====
        function openNewsDetailModal(id) {
            new bootstrap.Modal(document.getElementById('newsDetailModal')).show();
        }

        // ===== MAGAZINE MODAL =====
        function openMagModal() {
            new bootstrap.Modal(document.getElementById('magModal')).show();
        }

        let articleFontSize = 1.02;
        function adjustArticleFontSize(dir) {
            articleFontSize += (dir * 0.08);
            if (articleFontSize < 0.85) articleFontSize = 0.85;
            if (articleFontSize > 1.4) articleFontSize = 1.4;
            document.querySelectorAll('.article-body-text').forEach(el => {
                el.style.fontSize = articleFontSize + 'rem';
            });
        }

        function reactArticle(btn, icon) {
            btn.classList.toggle('btn-dark');
            btn.classList.toggle('text-white');
            showToast(`Cảm ơn bạn đã bày tỏ cảm xúc ${icon} với bài báo!`);
        }

        function showToast(msg) {
            const box = document.getElementById('toastBox');
            const toast = document.createElement('div');
            toast.className = 'toast-ri';
            toast.innerHTML = `<i class="fas fa-bell text-warning"></i><span>${msg}</span>`;
            box.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(15px)';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
</body>
</html>