            filterArticles();
        }

        // REAL-TIME SEARCH & CATEGORY COMBINED FILTER
        function filterArticles() {
            const query = (document.getElementById('newsSearchInput').value || '').toLowerCase().trim();
            const items = document.querySelectorAll('.article-item');
            let visibleCount = 0;

            items.forEach(item => {
                const itemCat = item.getAttribute('data-category');
                const itemText = item.innerText.toLowerCase();

                const matchesCat = (currentCategory === 'all' || itemCat === currentCategory);
                const matchesQuery = (!query || itemText.includes(query));

                if (matchesCat && matchesQuery) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Toggle empty message
            const emptyMsg = document.getElementById('noArticlesMsg');
            if (emptyMsg) {
                emptyMsg.classList.toggle('d-none', visibleCount > 0);
            }
        }

        function resetFilter() {
            document.getElementById('newsSearchInput').value = '';
            const allBtn = document.querySelector('.category-pill-btn[data-cat="all"]');
            filterCategory('all', allBtn);
        }
    </script>
</body>
</html>