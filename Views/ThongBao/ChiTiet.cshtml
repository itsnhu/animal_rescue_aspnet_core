@model HeThongCuuHo.Models.ThongBao

@{
    ViewData["Title"] = "Chi tiết thông báo";
}

<div class="card">

    <div class="card-header">

        <h3>

            @Model.TieuDe

        </h3>

    </div>

    <div class="card-body">

        <p>

            <strong>Loại:</strong>

            @Model.Loai

        </p>

        <p>

            <strong>Ngày gửi:</strong>

            @Model.NgayGui.ToString("dd/MM/yyyy HH:mm")

        </p>

        <hr />

        <p style="font-size:18px;">

            @Model.NoiDung

        </p>

    </div>

</div>

<a asp-action="Index"
   class="btn btn-secondary mt-3">

    Quay lại

</a>