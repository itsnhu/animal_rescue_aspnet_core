@model List<HeThongCuuHo.Models.DongVat>
@{
    Layout = null;
    ViewData["Title"] = "RescuePets - Trạm Cứu Hộ & Bảo Trợ Động Vật";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome 6 Pro Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Google Fonts: Chỉ giữ lại Dancing Script cho các tiêu đề phụ -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&display=swap" rel="stylesheet">
    <!-- Leaflet CSS for Map -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        :root {
            --ri-navy: #071D2A;
            --ri-navy-dark: #04121B;
            --ri-teal: #0F3832;
            --ri-teal-light: #EAF2EF;
            --ri-gold: #D4A373;
            --ri-gold-hover: #FAEDCD;
            --rp-amber: #D97706;
            --ri-bg: #F4F6F5;
            --ri-white: #FFFFFF;
            --ri-card-bg: #F9FAF9;
            --ri-text-dark: #122129;
            --ri-muted: #5A6D77;
            --ri-border: #E1E7E5;
            --ri-radius-card: 12px;
            --ri-radius-pill: 50px;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 80px;
            font-size: 13.5px; /* Thu nhỏ base size để vừa màn hình 100% */
        }

        /* ĐỒNG BỘ FONT CHỮ TIMES NEW ROMAN TOÀN TRANG */
        body {
            font-family: 'Times New Roman', Times, serif;
            background-color: var(--ri-bg);
            color: var(--ri-text-dark);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        section[id], div[id] { scroll-margin-top: 80px; }

        /* GIỮ NGUYÊN FONT CHỮ VIẾT TAY CHO CÁC TIÊU ĐỀ PHỤ */
        .script-accent {
            font-family: 'Dancing Script', cursive;
            color: var(--ri-gold);
            font-size: 1.6rem;
            font-weight: 700;
            display: block;
            margin-bottom: -2px;
        }

        .serif-title {
            font-family: 'Times New Roman', Times, serif;
            font-weight: 800;
            color: var(--ri-text-dark);
            letter-spacing: -0.5px;
        }

        /* ==================== TỐI ƯU NAVBAR MỚI (ĐÃ FIX OVERLAP) ==================== */
        .ri-header {
            background-color: var(--ri-navy);
            color: white;
            height: 72px;
            position: sticky;
            top: 0;
            z-index: 1050;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
        }

        /* Khu vực 1: Logo */
        .ri-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: white;
            flex-shrink: 0;
            margin-right: 20px;
        }

        .ri-brand-logo {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: var(--ri-gold);
            background: rgba(255, 255, 255, 0.05);
            flex-shrink: 0;
        }

        .ri-brand-title {
            font-family: 'Times New Roman', Times, serif;
            font-size: 1.4rem;
            font-weight: 800;
            line-height: 1;
            color: white;
        }

        .ri-brand-title small {
            display: block;
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--ri-gold);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 4px;
            white-space: nowrap;
        }

        /* Khu vực 2: Menu điều hướng ở giữa */
        .ri-nav-menu {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 18px;
            flex-grow: 1;
            flex-wrap: nowrap;
        }

        .ri-nav-link {
            font-family: 'Times New Roman', Times, serif;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.85) !important;
            padding: 10px 0;
            position: relative;
            text-decoration: none;
            transition: color 0.3s ease;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .ri-nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: var(--ri-gold);
            transform: scaleX(0);
            transition: transform 0.3s ease;
            transform-origin: center;
        }

        .ri-nav-link:hover, .ri-nav-link.active {
            color: var(--ri-gold) !important;
        }

        .ri-nav-link:hover::after, .ri-nav-link.active::after {
            transform: scaleX(1);
        }

        /* Khu vực 3: Chức năng bên phải */
        .ri-nav-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
            margin-left: 20px;
        }

        .btn-ri-search {
            width: 38px;
            height: 38px;
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.3s ease;
            text-decoration: none;
            flex-shrink: 0;
        }

        .btn-ri-search:hover {
            background: var(--ri-gold);
            color: var(--ri-navy);
        }

        .btn-bao-cuuho {
            background: #F5A623;
            color: #071D2A !important;
            border-radius: var(--ri-radius-pill);
            height: 38px;
            padding: 0 14px;
            font-family: 'Times New Roman', Times, serif;
            font-size: 13.5px;
            font-weight: 700;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            transition: all 0.3s ease;
            white-space: nowrap;
            box-shadow: 0 4px 12px rgba(245, 166, 35, 0.2);
            flex-shrink: 0;
        }

        .btn-bao-cuuho:hover {
            background: #e0961d;
            transform: translateY(-1px);
        }

        .btn-tai-khoan {
            background: transparent;
            color: white !important;
            border: 1.5px solid rgba(255, 255, 255, 0.3);
            border-radius: var(--ri-radius-pill);
            height: 38px;
            padding: 0 14px;
            font-family: 'Times New Roman', Times, serif;
            font-size: 13.5px;
            font-weight: 600;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s ease;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .btn-tai-khoan:hover, .btn-tai-khoan:focus {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--ri-gold);
            color: var(--ri-gold) !important;
        }

        /* Dropdown Menu Customization */
        .dropdown-menu {
            border-radius: 12px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            margin-top: 10px !important;
        }
        .dropdown-item {
            font-family: 'Times New Roman', Times, serif;
            font-size: 15px;
            font-weight: 500;
            padding: 10px 20px;
            transition: all 0.2s;
        }
        .dropdown-item:hover {
            background-color: #f8f9fa;
            color: var(--ri-teal);
        }

        /* Hamburger Mobile */
        .btn-hamburger {
            color: white;
            border: none;
            background: transparent;
            font-size: 24px;
            padding: 0;
            display: flex;
            align-items: center;
        }

        /* Offcanvas Mobile Menu */
        .offcanvas-menu {
            background-color: var(--ri-navy);
            color: white;
        }
        .offcanvas-menu .offcanvas-header {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .offcanvas-menu .offcanvas-body {
            padding: 20px;
        }
        .mobile-nav-link {
            display: block;
            color: white;
            text-decoration: none;
            font-family: 'Times New Roman', Times, serif;
            font-size: 16px;
            font-weight: 600;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            text-transform: uppercase;
        }
        .mobile-nav-link:hover, .mobile-nav-link.active {
            color: var(--ri-gold);
        }

        /* Responsive Fixes cho Navbar */
        @@media (max-width: 1399.98px) {
            .ri-nav-link { font-size: 13px; gap: 12px; }
            .btn-bao-cuuho, .btn-tai-khoan { font-size: 12.5px; padding: 0 10px; }
            .ri-brand-title { font-size: 1.3rem; }
        }
        @@media (max-width: 1199.98px) {
            .ri-nav-menu { gap: 8px; }
            .ri-nav-link { font-size: 12.5px; }
            .btn-bao-cuuho span { display: none; }
            .btn-bao-cuuho { padding: 0 12px; }
        }
        @@media (max-width: 991.98px) {
            .ri-brand { margin-right: 0; }
            .ri-nav-actions { margin-left: 0; }
        }
        /* ========================================================= */

        /* FIX LEAFLET MAP Z-INDEX */
        #shelterMap { z-index: 1 !important; isolation: isolate; }
        #shelterMap .leaflet-pane { z-index: 10 !important; }
        #shelterMap .leaflet-top, #shelterMap .leaflet-bottom, #shelterMap .leaflet-control { z-index: 20 !important; }

        /* HERO SECTION WITH YOUTUBE BACKGROUND */
        .ri-hero-wrap {
            position: relative;
            background-color: var(--ri-navy); /* Màu nền dự phòng */
            padding: 30px 0 90px 0;
            color: white;
            overflow: hidden; /* Ngăn iframe tràn ra ngoài */
        }

        /* CSS CHO IFRAME YOUTUBE LÀM NỀN */
        .hero-bg-iframe {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100vw;
            height: 56.25vw; /* Tỷ lệ 16:9 */
            min-height: 100vh;
            min-width: 177.77vh; /* Tỷ lệ 16:9 */
            transform: translate(-50%, -50%);
            z-index: 0;
            pointer-events: none; /* Chặn click vào video để click được nút bên trên */
            border: none;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            /* Lớp phủ màu tối giúp chữ trắng nổi bật trên video */
            background: linear-gradient(180deg, rgba(7, 29, 42, 0.6) 0%, rgba(7, 29, 42, 0.8) 100%);
            z-index: 1; /* Nằm trên video, dưới nội dung */
        }

        .ri-hero-content { max-width: 550px; }

        .ri-hero-main-title {
            font-family: 'Times New Roman', Times, serif;
            font-size: clamp(2.2rem, 4.5vw, 3.2rem);
            font-weight: 800;
            line-height: 1.05;
            color: white;
            margin-bottom: 5px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.4);
            white-space: nowrap;
        }

        .ri-hero-sub-title {
            font-family: 'Times New Roman', Times, serif;
            font-size: clamp(1.1rem, 2vw, 1.5rem);
            font-weight: 700;
            color: white;
            margin-bottom: 12px;
            text-shadow: 0 2px 8px rgba(0,0,0,0.4);
            white-space: nowrap;
        }

        .ri-hero-desc {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.9);
            line-height: 1.5;
            margin-bottom: 20px;
            max-width: 480px;
        }

        .btn-ri-hero-action {
            background: var(--ri-navy);
            color: white !important;
            border-radius: var(--ri-radius-pill);
            padding: 6px 6px 6px 18px;
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.8rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: 1.5px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .btn-ri-hero-action .arrow-circle {
            width: 26px;
            height: 26px;
            background: var(--ri-gold);
            color: var(--ri-navy);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            transition: transform 0.3s ease;
        }

        .btn-ri-hero-action:hover { background: var(--ri-gold); color: var(--ri-navy) !important; border-color: var(--ri-gold); }
        .btn-ri-hero-action:hover .arrow-circle { background: var(--ri-navy); color: white; transform: translateX(3px); }

        .ri-slider-arrow {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: rgba(7, 29, 42, 0.6);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .ri-slider-arrow:hover { background: var(--ri-gold); color: var(--ri-navy); }

        .ri-wave-divider { position: absolute; bottom: 0; left: 0; width: 100%; overflow: hidden; line-height: 0; z-index: 3; }
        .ri-wave-divider svg { position: relative; display: block; width: calc(100% + 1.3px); height: 40px; }
        .ri-wave-divider .shape-fill { fill: var(--ri-bg); }

        /* FLOATING CARDS */
        .ri-floating-hub { position: relative; z-index: 10; margin-top: -40px; margin-bottom: 20px; }

        .ri-icon-card {
            background: white;
            border-radius: var(--ri-radius-card);
            padding: 10px 8px;
            text-align: center;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
            border: 1px solid var(--ri-border);
            height: 100%;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            text-decoration: none;
            color: var(--ri-text-dark);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .ri-icon-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(7, 29, 42, 0.12); border-color: var(--ri-teal); color: var(--ri-text-dark); }

        .ri-icon-badge {
            width: 34px;
            height: 34px;
            background: var(--ri-teal);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            margin-bottom: 6px;
            box-shadow: 0 4px 12px rgba(15, 56, 50, 0.25);
            transition: transform 0.3s ease;
        }

        .ri-icon-card:hover .ri-icon-badge { transform: scale(1.1) rotate(-5deg); background: var(--ri-gold); color: var(--ri-navy); }

        .ri-icon-card-title {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--ri-text-dark);
            margin-bottom: 2px;
            white-space: nowrap;
        }

        .ri-icon-card-desc { font-size: 0.7rem; color: var(--ri-muted); margin-bottom: 0; line-height: 1.3; white-space: nowrap; }

        /* EVENTS SECTION */
        .ri-events-section { padding: 0 0 30px 0; }
        .ri-section-top { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 20px; }

        .ri-section-heading {
            font-family: 'Times New Roman', Times, serif;
            font-size: 1.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--ri-text-dark);
            margin-bottom: 0;
            line-height: 1.1;
            white-space: nowrap;
        }

        .btn-ri-view-all {
            background: var(--ri-navy);
            color: white !important;
            border-radius: var(--ri-radius-pill);
            padding: 5px 14px;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.25s ease;
            white-space: nowrap;
        }
        .btn-ri-view-all:hover { background: var(--ri-gold); color: var(--ri-navy) !important; }

        .ri-event-card {
            background: white; border-radius: var(--ri-radius-card); overflow: hidden;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05); border: 1px solid var(--ri-border);
            height: 100%; transition: all 0.3s ease; position: relative;
        }
        .ri-event-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.09); }
        .ri-event-img-wrap { position: relative; height: 160px; overflow: hidden; }
        .ri-event-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
        .ri-event-card:hover .ri-event-img { transform: scale(1.05); }

        .ri-date-badge {
            position: absolute; top: 8px; left: 8px; background: var(--ri-teal); color: white;
            border-radius: 6px; width: 42px; padding: 3px 0; text-align: center; box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
        }
        .ri-date-badge-num { font-family: 'Times New Roman', Times, serif; font-size: 1.1rem; font-weight: 800; line-height: 1; }
        .ri-date-badge-month { font-size: 0.55rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 1px; }
        .ri-event-body { padding: 12px; }
        .ri-event-title { font-family: 'Times New Roman', Times, serif; font-size: 0.95rem; font-weight: 800; color: var(--ri-text-dark); line-height: 1.3; margin-bottom: 8px; }
        .ri-event-location { font-size: 0.78rem; color: var(--ri-muted); display: flex; align-items: center; gap: 4px; font-weight: 600; }

        /* HYBRID SECTION */
        .ri-hybrid-section { padding: 20px 0 40px 0; }
        .ri-hybrid-card { background: white; border-radius: var(--ri-radius-card); padding: 16px; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05); border: 1px solid var(--ri-border); height: 100%; display: flex; flex-direction: column; }

        .ri-newsletter-card {
            background: linear-gradient(145deg, #0F3832 0%, #071D2A 60%, #122129 100%);
            color: white; border-radius: var(--ri-radius-card); padding: 20px 16px; position: relative;
            height: 100%; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden;
        }
        .ri-newsletter-card::before {
            content: '\f1b0'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
            position: absolute; bottom: -15px; right: -10px; font-size: 8rem;
            color: rgba(212, 163, 115, 0.06); transform: rotate(-15deg); pointer-events: none;
        }
        .ri-newsletter-card::after {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
            background: linear-gradient(90deg, var(--ri-gold), #E8B86D, var(--ri-gold)); border-radius: 12px 12px 0 0;
        }
        .ri-envelope-icon {
            width: 46px; height: 46px; background: linear-gradient(135deg, var(--ri-gold), #E8B86D);
            color: var(--ri-navy); border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem; position: absolute; top: 18px; right: 18px;
            box-shadow: 0 6px 20px rgba(212, 163, 115, 0.35); animation: envelopePulse 3s ease-in-out infinite;
        }
        @@keyframes envelopePulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
        .ri-newsletter-title { font-family: 'Times New Roman', Times, serif; font-size: 1.4rem; font-weight: 800; color: white; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 1px; white-space: nowrap; }
        .ri-newsletter-subtitle { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--ri-gold); margin-bottom: 12px; display: flex; align-items: center; gap: 6px; white-space: nowrap; }
        .ri-newsletter-desc { font-size: 0.9rem; color: rgba(255, 255, 255, 0.75); line-height: 1.5; margin-bottom: 16px; }
        .ri-newsletter-benefits { list-style: none; padding: 0; margin: 0 0 16px 0; }
        .ri-newsletter-benefits li { font-size: 0.85rem; color: rgba(255, 255, 255, 0.7); padding: 4px 0; display: flex; align-items: center; gap: 8px; white-space: nowrap; }
        .ri-newsletter-benefits li i { color: var(--ri-gold); font-size: 0.7rem; width: 16px; text-align: center; }
        .ri-newsletter-input-wrap { display: flex; background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(8px); border: 1.5px solid rgba(212, 163, 115, 0.3); border-radius: var(--ri-radius-pill); padding: 4px 4px 4px 16px; margin-bottom: 12px; transition: all 0.3s ease; }
        .ri-newsletter-input-wrap:focus-within { border-color: var(--ri-gold); background: rgba(255, 255, 255, 0.15); box-shadow: 0 0 0 3px rgba(212, 163, 115, 0.15); }
        .ri-newsletter-input { border: none; outline: none; width: 100%; font-size: 0.85rem; font-weight: 600; color: white; background: transparent; }
        .ri-newsletter-input::placeholder { color: rgba(255, 255, 255, 0.45); }
        .btn-ri-newsletter-send { width: 34px; height: 34px; background: linear-gradient(135deg, var(--ri-gold), #E8B86D); color: var(--ri-navy); border-radius: 50%; border: none; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; cursor: pointer; transition: all 0.3s ease; flex-shrink: 0; }
        .btn-ri-newsletter-send:hover { transform: scale(1.1) rotate(10deg); background: white; color: var(--ri-teal); box-shadow: 0 4px 14px rgba(255, 255, 255, 0.3); }
        .ri-newsletter-trust { display: flex; align-items: center; gap: 6px; font-size: 0.75rem; color: rgba(255, 255, 255, 0.4); margin-bottom: 14px; }
        .ri-newsletter-trust i { color: var(--ri-gold); }

        /* PRE-FOOTER */
        .ri-prefooter-banner { background: linear-gradient(180deg, rgba(7, 29, 42, 0.85) 0%, rgba(7, 29, 42, 0.95) 100%), url('https://images.unsplash.com/photo-1548199973-03cce0bbc87b?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat; color: white; padding: 30px 0; border-top-left-radius: 30px; border-top-right-radius: 30px; }
        .ri-prefooter-title { font-family: 'Times New Roman', Times, serif; font-size: 1.8rem; font-weight: 800; color: white; text-transform: uppercase; margin-bottom: 8px; white-space: nowrap; }
        .ri-prefooter-desc { font-size: 0.95rem; color: rgba(255, 255, 255, 0.8); max-width: 450px; margin-bottom: 16px; }
        .btn-ri-map-action { background: transparent; color: white !important; border: 1.5px solid var(--ri-gold); border-radius: var(--ri-radius-pill); padding: 6px 20px; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.25s ease; white-space: nowrap; }
        .btn-ri-map-action:hover { background: var(--ri-gold); color: var(--ri-navy) !important; }

        /* FOOTER */
        .ri-footer { background-color: var(--ri-navy-dark); color: white; padding: 30px 0 15px 0; border-top: 1px solid rgba(255, 255, 255, 0.08); }
        .ri-footer-heading { font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: var(--ri-gold); margin-bottom: 12px; white-space: nowrap; }
        .ri-footer-link { color: rgba(255, 255, 255, 0.75); text-decoration: none; font-size: 0.9rem; font-weight: 500; display: block; margin-bottom: 6px; transition: color 0.2s ease; white-space: nowrap; }
        .ri-footer-link:hover { color: var(--ri-gold); }

        /* TOAST & BACK TO TOP */
        .toast-container-ri { position: fixed; bottom: 30px; left: 30px; z-index: 1060; }
        .toast-ri { background: var(--ri-navy); color: white; padding: 13px 22px; border-radius: 10px; box-shadow: 0 12px 30px rgba(0,0,0,0.3); font-size: 0.9rem; font-weight: 700; display: flex; align-items: center; gap: 10px; border: 1px solid var(--ri-gold); animation: slideUp 0.3s ease; }
        @@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        .btn-back-top { position: fixed; bottom: 30px; right: 30px; width: 46px; height: 46px; background: var(--ri-gold); color: var(--ri-navy); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25); cursor: pointer; border: none; opacity: 0; visibility: hidden; transition: all 0.3s ease; z-index: 99; }
        .btn-back-top.show { opacity: 1; visibility: visible; }
        .btn-back-top:hover { background: white; color: var(--ri-navy); transform: translateY(-3px); }

        /* ==================== RESPONSIVE TỔNG THỂ ==================== */
        @@media (max-width: 1199.98px) {
            .ri-hero-main-title { font-size: 2.8rem; }
            .ri-hero-sub-title { font-size: 1.3rem; }
            .ri-floating-hub { margin-top: -30px; }
        }
        @@media (max-width: 991.98px) {
            .ri-section-heading { font-size: 1.4rem; }
            .ri-prefooter-title { font-size: 1.2rem; }
        }
        @@media (max-width: 767.98px) {
            .ri-hero-wrap { padding: 20px 0 70px 0; }
            .ri-hero-main-title { font-size: 2.2rem; }
            .ri-hero-sub-title { font-size: 1.1rem; }
            .ri-hero-desc { font-size: 0.9rem; }
            .ri-floating-hub { margin-top: 15px; }
            .ri-wave-divider svg { height: 30px; }
            .ri-icon-card { padding: 8px 4px; }
            .ri-icon-badge { width: 30px; height: 30px; font-size: 0.8rem; margin-bottom: 4px; }
            .ri-icon-card-title { font-size: 0.65rem; letter-spacing: 0.2px; }
            .ri-icon-card-desc { font-size: 0.6rem; }
            .ri-section-heading { font-size: 1.2rem; }
            .ri-prefooter-title { font-size: 1.1rem; }
            .ri-newsletter-title { font-size: 1.1rem; }
            .ri-footer-heading { font-size: 0.7rem; }
            .ri-footer-link { font-size: 0.75rem; }
        }
        @@media (max-width: 575.98px) {
            .ri-hero-main-title { font-size: 1.8rem; }
            .ri-hero-sub-title { font-size: 1rem; }
            .ri-section-heading { font-size: 1rem; }
            .ri-icon-card-title { font-size: 0.6rem; }
            .ri-icon-card-desc { font-size: 0.55rem; }
            .ri-brand-title small { font-size: 0.5rem; }
            .ri-newsletter-title { font-size: 0.9rem; }
            .ri-prefooter-title { font-size: 0.9rem; }
        }
    </style>
</head>
<body>

    <!-- ================= TOP HEADER / NAVBAR TỐI ƯU ================= -->
    <header class="ri-header" id="mainHeader">
        <div class="container-fluid px-xl-5 px-3">
            <div class="d-flex align-items-center justify-content-between h-100">
                
                <!-- KHU VỰC 1: LOGO BÊN TRÁI -->
                <a href="/Home/Welcome" class="ri-brand">
                    <div class="ri-brand-logo">
                        <i class="fas fa-paw"></i>
                    </div>
                    <div class="ri-brand-title">
                        <span>RescuePets</span>
                        <small>Cứu Hộ & Bảo Trợ Động Vật</small>
                    </div>
                </a>

                <!-- KHU VỰC 2: MENU ĐIỀU HƯỚNG Ở GIỮA (DESKTOP) -->
                <nav class="ri-nav-menu d-none d-lg-flex">
                    <a href="/Home/Welcome#trang-chu" class="ri-nav-link active">Trang Chủ</a>
                    <a href="/Home/Welcome#ve-tram" class="ri-nav-link">Về Trạm</a>
                    <a href="/Home/Welcome#thu-cung" class="ri-nav-link">Thú Cưng</a>
                    <a href="/Home/TinTuc" class="ri-nav-link">Tin Tức & Tạp Chí</a>
                    <a href="/Home/Welcome#quyen-gop" class="ri-nav-link">Quyên Góp</a>
                    <!-- ĐÃ SỬA ĐƯỜNG DẪN SANG TRANG LIÊN HỆ -->
                    <a asp-controller="Home" asp-action="Contact" class="ri-nav-link">Liên Hệ</a>
                </nav>

                <!-- NÚT HAMBURGER (MOBILE) -->
                <button class="btn-hamburger d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
                    <i class="fas fa-bars"></i>
                </button>

                <!-- KHU VỰC 3: CHỨC NĂNG BÊN PHẢI -->
                <div class="ri-nav-actions d-none d-lg-flex">
                    <!-- Tìm kiếm -->
                    <a href="/Home/Welcome#thu-cung" class="btn-ri-search" title="Tìm kiếm">
                        <i class="fas fa-magnifying-glass"></i>
                    </a>

                    <!-- Báo cứu hộ -->
                    <a asp-controller="Home" asp-action="BaoCao" class="btn-bao-cuuho">
                        <i class="fas fa-truck-medical"></i> <span>Báo Cứu Hộ</span>
                    </a>

                    <!-- Tài khoản / Đăng nhập -->
                    @if (Context.Session.GetString("TenDangNhap") != null)
                    {
                        <div class="dropdown">
                            <button class="btn-tai-khoan dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle fs-5"></i>
                                <span class="text-truncate" style="max-width: 100px;">@Context.Session.GetString("TenDangNhap")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item fw-semibold" href="/Home/Index"><i class="fas fa-gauge me-2 text-primary"></i>Giao Diện Hệ Thống</a></li>
                                <li><a class="dropdown-item fw-semibold" href="/Profile/Index"><i class="fas fa-user-gear me-2 text-info"></i>Trang Cá Nhân</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item fw-semibold text-danger" href="/Login/DangXuat"><i class="fas fa-right-from-bracket me-2"></i>Đăng Xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="btn-tai-khoan dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user"></i> Tài Khoản
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item fw-semibold" href="/Login"><i class="fas fa-right-to-bracket me-2 text-warning"></i>Đăng Nhập</a></li>
                                <li><a class="dropdown-item fw-semibold" href="/Login/DangKy"><i class="fas fa-user-plus me-2 text-success"></i>Đăng Ký</a></li>
                            </ul>
                        </div>
                    }
                </div>

            </div>
        </div>
    </header>

    <!-- OFFCANVAS MOBILE MENU -->
    <div class="offcanvas offcanvas-end offcanvas-menu" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title serif-title text-white" id="mobileMenuLabel">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <a href="/Home/Welcome#trang-chu" class="mobile-nav-link active" data-bs-dismiss="offcanvas">Trang Chủ</a>
            <a href="/Home/Welcome#ve-tram" class="mobile-nav-link" data-bs-dismiss="offcanvas">Về Trạm</a>
            <a href="/Home/Welcome#thu-cung" class="mobile-nav-link" data-bs-dismiss="offcanvas">Thú Cưng</a>
            <a href="/Home/TinTuc" class="mobile-nav-link" data-bs-dismiss="offcanvas">Tin Tức & Tạp Chí</a>
            <a href="/Home/Welcome#quyen-gop" class="mobile-nav-link" data-bs-dismiss="offcanvas">Quyên Góp</a>
            <!-- ĐÃ SỬA ĐƯỜNG DẪN SANG TRANG LIÊN HỆ -->
            <a asp-controller="Home" asp-action="Contact" class="mobile-nav-link" data-bs-dismiss="offcanvas">Liên Hệ</a>
            
            <hr class="border-secondary my-3">
            
            <!-- Chức năng Mobile -->
            <a href="/Home/Welcome#thu-cung" class="mobile-nav-link" data-bs-dismiss="offcanvas"><i class="fas fa-search me-2"></i> Tìm Kiếm</a>
            <a asp-controller="Home" asp-action="BaoCao" class="btn btn-warning w-100 rounded-pill mt-2 fw-bold text-uppercase"><i class="fas fa-truck-medical me-2"></i>Báo Cứu Hộ</a>
            
            @if (Context.Session.GetString("TenDangNhap") == null)
            {
                <div class="d-flex gap-2 mt-3">
                    <a href="/Login" class="btn btn-outline-light w-50 rounded-pill fw-bold">Đăng Nhập</a>
                    <a href="/Login/DangKy" class="btn btn-gold w-50 rounded-pill fw-bold" style="background: var(--ri-gold); color: var(--ri-navy);">Đăng Ký</a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2 mt-3">
                    <a href="/Home/Index" class="btn btn-outline-light w-100 rounded-pill fw-bold">Giao Diện Hệ Thống</a>
                    <a href="/Profile/Index" class="btn btn-outline-light w-100 rounded-pill fw-bold">Trang Cá Nhân</a>
                    <a href="/Login/DangXuat" class="btn btn-danger w-100 rounded-pill fw-bold">Đăng Xuất</a>
                </div>
            }
        </div>
    </div>

    <!-- ================= 1. HERO SECTION ================= -->
    <section class="ri-hero-wrap" id="trang-chu">
        <!-- YOUTUBE BACKGROUND - Link: https://www.youtube.com/watch?v=RAf2Mx7gvN0 -->
        <iframe class="hero-bg-iframe" 
                src="https://www.youtube.com/embed/kdzO8Nndilo?autoplay=1&mute=1&loop=1&playlist=kdzO8Nndilo&controls=0&showinfo=0&modestbranding=1&rel=0&playsinline=1" 
                frameborder="0" 
                allow="autoplay; encrypted-media" 
                allowfullscreen>
        </iframe>
        
        <!-- LỚP PHỦ TỐI GIÚP ĐỌC CHỮ RÕ HƠN -->
        <div class="hero-overlay"></div>

        <div class="container position-relative z-2">
            <div class="d-flex align-items-center justify-content-between">
                
                <div class="ri-slider-arrow d-none d-md-flex" onclick="changeHeroSlide(-1)" title="Ảnh trước">
                    <i class="fas fa-chevron-left"></i>
                </div>

                <div class="ri-hero-content text-center text-md-start mx-auto mx-md-0">
                    <span class="script-accent">Chào mừng đến với</span>
                    <h1 class="ri-hero-main-title">RescuePets</h1>
                    <h2 class="ri-hero-sub-title">Trạm Cứu Hộ & Bảo Trợ Động Vật</h2>
                    <p class="ri-hero-desc">
                        Nơi kết nối yêu thương, tiếp nhận cứu hộ khẩn cấp 24/7 và mang lại mái ấm gia đình hạnh phúc cho các bé chó mèo cơ nhỡ.
                    </p>
                    
                    <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-3">
                        <a href="#thu-cung" class="btn-ri-hero-action">
                            <span>Khám Phá Thú Cưng</span>
                            <span class="arrow-circle"><i class="fas fa-arrow-right"></i></span>
                        </a>
                        <a href="/Home/TinTuc" class="btn btn-outline-light rounded-pill px-3 py-2 fw-bold text-uppercase d-inline-flex align-items-center gap-2 text-nowrap" style="font-size: 0.78rem; border-width: 1.5px;">
                            <span>Đọc Tin Tức Trạm</span>
                            <i class="fas fa-newspaper text-warning"></i>
                        </a>
                    </div>

                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mt-3" id="heroDotsContainer">
                        <span class="dot-item active" onclick="setHeroSlide(0)" style="width: 20px; height: 6px; background: var(--ri-gold); border-radius: 10px; cursor: pointer; transition: all 0.3s ease;"></span>
                        <span class="dot-item" onclick="setHeroSlide(1)" style="width: 6px; height: 6px; background: rgba(255,255,255,0.4); border-radius: 50%; cursor: pointer; transition: all 0.3s ease;"></span>
                        <span class="dot-item" onclick="setHeroSlide(2)" style="width: 6px; height: 6px; background: rgba(255,255,255,0.4); border-radius: 50%; cursor: pointer; transition: all 0.3s ease;"></span>
                        <span class="dot-item" onclick="setHeroSlide(3)" style="width: 6px; height: 6px; background: rgba(255,255,255,0.4); border-radius: 50%; cursor: pointer; transition: all 0.3s ease;"></span>
                    </div>
                </div>

                <div class="ri-slider-arrow d-none d-md-flex" onclick="changeHeroSlide(1)" title="Ảnh tiếp theo">
                    <i class="fas fa-chevron-right"></i>
                </div>

            </div>
        </div>

        <div class="ri-wave-divider">
            <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M0,0 C150,90 350,-40 500,45 C650,130 900,10 1200,50 L1200,120 L0,120 Z" class="shape-fill"></path>
            </svg>
        </div>
    </section>

    <!-- ================= 6 FLOATING ICON FEATURE CARDS OVERLAPPING HERO ================= -->
    <div class="container ri-floating-hub">
        <div class="row g-2 g-md-3">
            
            <div class="col-lg-2 col-md-4 col-6">
                <a asp-controller="Home" asp-action="BaoCao" class="ri-icon-card">
                    <div class="ri-icon-badge"><i class="fas fa-truck-medical"></i></div>
                    <h6 class="ri-icon-card-title">Cứu Hộ Khẩn Cấp</h6>
                    <p class="ri-icon-card-desc">Báo cáo tai nạn 24/7</p>
                </a>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <a href="#thu-cung" class="ri-icon-card">
                    <div class="ri-icon-badge"><i class="fas fa-heart"></i></div>
                    <h6 class="ri-icon-card-title">Nhận Nuôi Thú Cưng</h6>
                    <p class="ri-icon-card-desc">Đón các bé về nhà</p>
                </a>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <a href="#quyen-gop" class="ri-icon-card">
                    <div class="ri-icon-badge"><i class="fas fa-gift"></i></div>
                    <h6 class="ri-icon-card-title">Ủng Hộ & Quyên Góp</h6>
                    <p class="ri-icon-card-desc">Quyên góp y tế & hạt</p>
                </a>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <a href="#cach-giup-do" class="ri-icon-card">
                    <div class="ri-icon-badge"><i class="fas fa-hands-holding-child"></i></div>
                    <h6 class="ri-icon-card-title">Tình Nguyện Viên</h6>
                    <p class="ri-icon-card-desc">Đồng hành cùng trạm</p>
                </a>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <a href="#cach-giup-do" class="ri-icon-card">
                    <div class="ri-icon-badge"><i class="fas fa-shield-cat"></i></div>
                    <h6 class="ri-icon-card-title">Chăm Sóc Y Tế</h6>
                    <p class="ri-icon-card-desc">Tiêm phòng & triệt sản</p>
                </a>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <a href="#lien-he" class="ri-icon-card">
                    <div class="ri-icon-badge"><i class="fas fa-map-location-dot"></i></div>
                    <h6 class="ri-icon-card-title">Địa Chỉ Trạm</h6>
                    <p class="ri-icon-card-desc">Tham quan & giao lưu</p>
                </a>
            </div>

        </div>
    </div>

    <!-- ================= 2. "ÉVÉNEMENTS" SECTION ================= -->
    <section class="ri-events-section" id="thu-cung">
        <div class="container">
            
            <div class="ri-section-top">
                <div>
                    <span class="script-accent">Cập nhật mới nhất</span>
                    <h2 class="ri-section-heading">Sự Kiện & Thú Cưng Nổi Bật</h2>
                </div>
                <a href="#quyen-gop" class="btn-ri-view-all" onclick="toggleMorePets()">
                    <span>Tất Cả Thú Cưng</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <div class="row g-3" id="petCardGrid">
                
                <!-- Event Card 1: Teddy -->
                <div class="col-lg-4 col-md-6 pet-item-card">
                    <div class="ri-event-card">
                        <div class="ri-event-img-wrap">
                            <img src="/images/pet_teddy.jpg" alt="Teddy" class="ri-event-img">
                            <div class="ri-date-badge">
                                <div class="ri-date-badge-num">12</div>
                                <div class="ri-date-badge-month">TH3 9</div>
                            </div>
                        </div>
                        <div class="ri-event-body">
                            <h4 class="ri-event-title">Bé Teddy - Golden Retriever ngoan hiền tìm mái ấm mới</h4>
                            <div class="ri-event-location">
                                <i class="fas fa-location-dot text-danger"></i>
                                <span>Trạm Cứu Hộ Hà Nội · 1.5 tuổi (Đực)</span>
                            </div>
                            <button class="btn btn-sm btn-outline-danger rounded-pill w-100 mt-2 fw-bold" style="font-size: 0.78rem;" onclick="openPetModal('Teddy', 'Chó', 'Golden Retriever lai', 'Đực', 1.5, '14 kg', 'Đã tiêm 3 mũi, rất quấn người', '/images/pet_teddy.jpg', 1)">
                                Xem Chi Tiết & Nhận Nuôi
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Event Card 2: Bella -->
                <div class="col-lg-4 col-md-6 pet-item-card">
                    <div class="ri-event-card">
                        <div class="ri-event-img-wrap">
                            <img src="/images/pet_bella.jpg" alt="Bella" class="ri-event-img">
                            <div class="ri-date-badge">
                                <div class="ri-date-badge-num">03</div>
                                <div class="ri-date-badge-month">TH3 9</div>
                            </div>
                        </div>
                        <div class="ri-event-body">
                            <h4 class="ri-event-title">Bé Bella - Beagle năng động đã hoàn thành tiêm phòng</h4>
                            <div class="ri-event-location">
                                <i class="fas fa-location-dot text-danger"></i>
                                <span>Trạm Cứu Hộ Hà Nội · 8 tháng (Cái)</span>
                            </div>
                            <button class="btn btn-sm btn-outline-danger rounded-pill w-100 mt-2 fw-bold" style="font-size: 0.78rem;" onclick="openPetModal('Bella', 'Chó', 'Beagle thuần chủng', 'Cái', 0.8, '7.5 kg', 'Năng động, đã triệt sản', '/images/pet_bella.jpg', 2)">
                                Xem Chi Tiết & Nhận Nuôi
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Event Card 3: Prince -->
                <div class="col-lg-4 col-md-6 pet-item-card">
                    <div class="ri-event-card">
                        <div class="ri-event-img-wrap">
                            <img src="/images/pet_prince.jpg" alt="Prince" class="ri-event-img">
                            <div class="ri-date-badge">
                                <div class="ri-date-badge-num">07</div>
                                <div class="ri-date-badge-month">TH3 8</div>
                            </div>
                        </div>
                        <div class="ri-event-body">
                            <h4 class="ri-event-title">Bé Prince - Corgi chân ngắn thông minh nghe lời</h4>
                            <div class="ri-event-location">
                                <i class="fas fa-location-dot text-danger"></i>
                                <span>Trạm Cứu Hộ Hà Nội · 2 tuổi (Đực)</span>
                            </div>
                            <button class="btn btn-sm btn-outline-danger rounded-pill w-100 mt-2 fw-bold" style="font-size: 0.78rem;" onclick="openPetModal('Prince', 'Chó', 'Welsh Corgi', 'Đực', 2, '11 kg', 'Thông minh, nghe lời', '/images/pet_prince.jpg', 3)">
                                Xem Chi Tiết & Nhận Nuôi
                            </button>
                        </div>
