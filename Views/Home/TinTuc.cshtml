@{
    Layout = null;
    ViewData["Title"] = "Tin Tức & Tạp Chí - RescuePets";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome 6 Pro Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Google Fonts: Chỉ giữ lại Dancing Script cho các tiêu đề phụ -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --ri-navy: #071D2A;
            --ri-navy-dark: #04121B;
            --ri-teal: #0F3832;
            --ri-teal-light: #EAF2EF;
            --ri-gold: #D4A373;
            --ri-gold-hover: #FAEDCD;
            --ri-bg: #F4F6F5;
            --ri-white: #FFFFFF;
            --ri-text-dark: #122129;
            --ri-muted: #5A6D77;
            --ri-border: #E1E7E5;
            --ri-radius-card: 16px;
            --ri-radius-pill: 50px;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 80px;
            font-size: 13.5px; /* Thu nhỏ base size để vừa màn hình 100% */
        }

        * { box-sizing: border-box; }

        /* ĐỒNG BỘ FONT CHỮ TIMES NEW ROMAN TOÀN TRANG */
        body {
            font-family: 'Times New Roman', Times, serif;
            background-color: var(--ri-bg);
            color: var(--ri-text-dark);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* GIỮ NGUYÊN FONT CHỮ VIẾT TAY CHO CÁC TIÊU ĐỀ PHỤ */
        .script-accent {
            font-family: 'Dancing Script', cursive;
            color: var(--ri-gold);
            font-size: 1.8rem;
            font-weight: 700;
            display: block;
        }

        .serif-title {
            font-family: 'Times New Roman', Times, serif;
            font-weight: 800;
            color: var(--ri-text-dark);
            letter-spacing: -0.5px;
        }

        /* ==================== TỐI ƯU NAVBAR MỚI (ĐÃ FIX OVERLAP) ==================== */
        .ri-header {
            background-color: var(--ri-navy);
            color: white;
            height: 72px;
            position: sticky;
            top: 0;
            z-index: 1050;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
        }

        /* Khu vực 1: Logo */
        .ri-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: white;
            flex-shrink: 0;
            margin-right: 20px;
        }

        .ri-brand-logo {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: var(--ri-gold);
            background: rgba(255, 255, 255, 0.05);
            flex-shrink: 0;
        }

        .ri-brand-title {
            font-family: 'Times New Roman', Times, serif;
            font-size: 1.4rem;
            font-weight: 800;
            line-height: 1;
            color: white;
        }

        .ri-brand-title small {
            display: block;
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--ri-gold);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 4px;
            white-space: nowrap;
        }

        /* Khu vực 2: Menu điều hướng ở giữa */
        .ri-nav-menu {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 18px;
            flex-grow: 1;
            flex-wrap: nowrap;
        }

        .ri-nav-link {
            font-family: 'Times New Roman', Times, serif;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.85) !important;
            padding: 10px 0;
            position: relative;
            text-decoration: none;
            transition: color 0.3s ease;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .ri-nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: var(--ri-gold);
            transform: scaleX(0);
            transition: transform 0.3s ease;
            transform-origin: center;
        }

        .ri-nav-link:hover, .ri-nav-link.active {
            color: var(--ri-gold) !important;
        }

        .ri-nav-link:hover::after, .ri-nav-link.active::after {
            transform: scaleX(1);
        }

        /* Khu vực 3: Chức năng bên phải */
        .ri-nav-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
            margin-left: 20px;
        }

        .btn-ri-search {
            width: 38px;
            height: 38px;
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.3s ease;
            text-decoration: none;
            flex-shrink: 0;
        }

        .btn-ri-search:hover {
            background: var(--ri-gold);
            color: var(--ri-navy);
        }

        .btn-bao-cuuho {
            background: #F5A623;
            color: #071D2A !important;
            border-radius: var(--ri-radius-pill);
            height: 38px;
            padding: 0 14px;
            font-family: 'Times New Roman', Times, serif;
            font-size: 13.5px;
            font-weight: 700;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            transition: all 0.3s ease;
            white-space: nowrap;
            box-shadow: 0 4px 12px rgba(245, 166, 35, 0.2);
            flex-shrink: 0;
        }

        .btn-bao-cuuho:hover {
            background: #e0961d;
            transform: translateY(-1px);
        }

        .btn-tai-khoan {
            background: transparent;
            color: white !important;
            border: 1.5px solid rgba(255, 255, 255, 0.3);
            border-radius: var(--ri-radius-pill);
            height: 38px;
            padding: 0 14px;
            font-family: 'Times New Roman', Times, serif;
            font-size: 13.5px;
            font-weight: 600;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s ease;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .btn-tai-khoan:hover, .btn-tai-khoan:focus {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--ri-gold);
            color: var(--ri-gold) !important;
        }

        /* Dropdown Menu Customization */
        .dropdown-menu {
            border-radius: 12px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            margin-top: 10px !important;
        }
        .dropdown-item {
            font-family: 'Times New Roman', Times, serif;
            font-size: 15px;
            font-weight: 500;
            padding: 10px 20px;
            transition: all 0.2s;
        }
        .dropdown-item:hover {
            background-color: #f8f9fa;
            color: var(--ri-teal);
        }

        /* Hamburger Mobile */
        .btn-hamburger {
            color: white;
            border: none;
            background: transparent;
            font-size: 24px;
            padding: 0;
            display: flex;
            align-items: center;
        }

        /* Offcanvas Mobile Menu */
        .offcanvas-menu {
            background-color: var(--ri-navy);
            color: white;
        }
        .offcanvas-menu .offcanvas-header {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .offcanvas-menu .offcanvas-body {
            padding: 20px;
        }
        .mobile-nav-link {
            display: block;
            color: white;
            text-decoration: none;
            font-family: 'Times New Roman', Times, serif;
            font-size: 16px;
            font-weight: 600;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            text-transform: uppercase;
        }
        .mobile-nav-link:hover, .mobile-nav-link.active {
            color: var(--ri-gold);
        }

        /* Responsive Fixes cho Navbar */
        @@media (max-width: 1399.98px) {
            .ri-nav-link { font-size: 13px; gap: 12px; }
            .btn-bao-cuuho, .btn-tai-khoan { font-size: 12.5px; padding: 0 10px; }
            .ri-brand-title { font-size: 1.3rem; }
        }
        @@media (max-width: 1199.98px) {
            .ri-nav-menu { gap: 8px; }
            .ri-nav-link { font-size: 12.5px; }
            .btn-bao-cuuho span { display: none; }
            .btn-bao-cuuho { padding: 0 12px; }
        }
        @@media (max-width: 991.98px) {
            .ri-brand { margin-right: 0; }
            .ri-nav-actions { margin-left: 0; }
        }
        /* ========================================================= */

        /* HERO BANNER */
        .news-hero-banner {
            background: linear-gradient(135deg, var(--ri-navy-dark) 0%, var(--ri-navy) 60%, var(--ri-teal) 100%);
            color: white;
            padding: 60px 0 75px;
            position: relative;
            text-align: center;
        }

        .news-hero-banner::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 25px;
            background: var(--ri-bg);
            border-radius: 30px 30px 0 0;
        }

        /* SEARCH BAR */
        .news-search-box {
            max-width: 580px;
            margin: 25px auto 0;
            background: white;
            border-radius: 50px;
            padding: 6px 8px 6px 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.25);
            display: flex;
            align-items: center;
        }

        .news-search-box input {
            border: none;
            outline: none;
            flex-grow: 1;
            font-size: 0.95rem;
            color: var(--ri-text-dark);
            padding: 6px 10px;
            font-family: 'Times New Roman', Times, serif;
        }

        .news-search-box button {
            background: linear-gradient(135deg, #0F3832 0%, #071D2A 100%);
            color: var(--ri-gold);
            border: 1px solid rgba(212,163,115,0.4);
            border-radius: 50px;
            font-weight: 800;
            font-size: 0.85rem;
            padding: 10px 22px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.25s ease;
            font-family: 'Times New Roman', Times, serif;
        }

        .news-search-box button:hover {
            background: var(--ri-gold);
            color: var(--ri-navy);
            border-color: var(--ri-gold);
        }

        /* CATEGORY FILTER PILLS */
        .category-filter-nav {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin-bottom: 35px;
        }

        .category-pill-btn {
            background: white;
            border: 1.5px solid #E2E8F0;
            color: #475569;
            padding: 9px 22px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            font-family: 'Times New Roman', Times, serif;
        }

        .category-pill-btn:hover {
            border-color: var(--ri-teal);
            color: var(--ri-teal);
            transform: translateY(-2px);
        }

        .category-pill-btn.active {
            background: var(--ri-teal) !important;
            color: white !important;
            border-color: var(--ri-teal) !important;
            box-shadow: 0 4px 14px rgba(15, 56, 50, 0.25);
        }

        /* FEATURED ARTICLE CARD */
        .featured-news-card {
            background: white;
            border-radius: var(--ri-radius-card);
            overflow: hidden;
            box-shadow: 0 12px 35px rgba(7, 29, 42, 0.08);
            border: 1px solid rgba(7, 29, 42, 0.06);
            margin-bottom: 40px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .featured-news-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 45px rgba(7, 29, 42, 0.12);
        }

        .featured-img-wrap {
            height: 380px;
            position: relative;
            overflow: hidden;
        }

        .featured-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .featured-news-card:hover .featured-img {
            transform: scale(1.05);
        }

        .featured-badge {
            position: absolute;
            top: 20px;
            left: 20px;
            background: var(--ri-navy);
            color: var(--ri-gold);
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 6px 14px;
            border-radius: 6px;
            border: 1px solid rgba(212,163,115,0.4);
        }

        /* ARTICLE GRID CARD */
        .article-card {
            background: white;
            border-radius: var(--ri-radius-card);
            overflow: hidden;
            border: 1px solid rgba(7, 29, 42, 0.06);
            box-shadow: 0 8px 24px rgba(7, 29, 42, 0.05);
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .article-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 36px rgba(7, 29, 42, 0.1);
            border-color: var(--ri-gold);
        }

        .article-img-wrap {
            height: 220px;
            position: relative;
            overflow: hidden;
        }

        .article-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .article-card:hover .article-img {
            transform: scale(1.06);
        }

        .article-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            background: var(--ri-navy);
            color: var(--ri-gold);
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 6px;
            border: 1px solid rgba(212,163,115,0.3);
        }

        .article-body {
            padding: 24px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .article-date {
            font-size: 0.82rem;
            color: var(--ri-muted);
            font-weight: 600;
            margin-bottom: 8px;
        }

        .article-title {
            font-family: 'Times New Roman', Times, serif;
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--ri-text-dark);
            line-height: 1.45;
            margin-bottom: 12px;
        }

        .article-desc {
            font-size: 0.95rem;
            color: var(--ri-muted);
            line-height: 1.6;
            margin-bottom: 20px;
            flex-grow: 1;
        }

        .btn-read-more {
            color: var(--ri-teal);
            font-weight: 800;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.25s ease;
        }

        .article-card:hover .btn-read-more {
            color: var(--ri-gold);
            gap: 10px;
        }

        /* MAGAZINE BANNER */
        .mag-banner-card {
            background: linear-gradient(135deg, var(--ri-navy) 0%, var(--ri-teal) 100%);
            color: white;
            border-radius: var(--ri-radius-card);
            padding: 45px 35px;
            position: relative;
            overflow: hidden;
            margin: 50px 0 30px;
            box-shadow: 0 15px 40px rgba(7, 29, 42, 0.12);
        }

        .btn-open-mag {
            background: var(--ri-gold);
            color: var(--ri-navy);
            font-weight: 800;
            border-radius: var(--ri-radius-pill);
            padding: 13px 30px;
            border: none;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.25s ease;
            cursor: pointer;
            box-shadow: 0 6px 18px rgba(212, 163, 115, 0.35);
            font-family: 'Times New Roman', Times, serif;
        }

        .btn-open-mag:hover {
            background: white;
            color: var(--ri-navy);
            transform: translateY(-2px);
        }

        /* MODAL STYLES */
        .modal-content {
            border-radius: 20px;
            border: none;
            overflow: hidden;
        }

        .modal-header-ri {
            background: var(--ri-navy);
            color: white;
            padding: 18px 24px;
            border-bottom: 2px solid var(--ri-gold);
        }

        .flipbook-page {
            background: #FAF8F5;
            border: 1px solid #E5E0D8;
            border-radius: 14px;
            padding: 30px;
            min-height: 460px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.03);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
    </style>
</head>
<body>

    <!-- ================= TOP HEADER / NAVBAR TỐI ƯU ================= -->
    <header class="ri-header" id="mainHeader">
        <div class="container-fluid px-xl-5 px-3">
            <div class="d-flex align-items-center justify-content-between h-100">
                
                <!-- KHU VỰC 1: LOGO BÊN TRÁI -->
                <a href="/Home/Welcome" class="ri-brand">
                    <div class="ri-brand-logo">
                        <i class="fas fa-paw"></i>
                    </div>
                    <div class="ri-brand-title">
                        <span>RescuePets</span>
                        <small>Cứu Hộ & Bảo Trợ Động Vật</small>
                    </div>
                </a>

                <!-- KHU VỰC 2: MENU ĐIỀU HƯỚNG Ở GIỮA (DESKTOP) -->
                <nav class="ri-nav-menu d-none d-lg-flex">
                    <a href="/Home/Welcome#trang-chu" class="ri-nav-link">Trang Chủ</a>
                    <a href="/Home/Welcome#ve-tram" class="ri-nav-link">Về Trạm</a>
                    <a href="/Home/Welcome#thu-cung" class="ri-nav-link">Thú Cưng</a>
                    <a href="/Home/TinTuc" class="ri-nav-link active">Tin Tức & Tạp Chí</a>
                    <a href="/Home/Welcome#quyen-gop" class="ri-nav-link">Quyên Góp</a>
                    <a href="/Home/Welcome#lien-he" class="ri-nav-link">Liên Hệ</a>
                </nav>

                <!-- NÚT HAMBURGER (MOBILE) -->
                <button class="btn-hamburger d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
                    <i class="fas fa-bars"></i>
                </button>

                <!-- KHU VỰC 3: CHỨC NĂNG BÊN PHẢI -->
                <div class="ri-nav-actions d-none d-lg-flex">
                    <!-- Tìm kiếm -->
                    <a href="#search-section" class="btn-ri-search" title="Tìm kiếm">
                        <i class="fas fa-magnifying-glass"></i>
                    </a>

                    <!-- Báo cứu hộ -->
                    <a asp-controller="Home" asp-action="BaoCao" class="btn-bao-cuuho">
                        <i class="fas fa-truck-medical"></i> <span>Báo Cứu Hộ</span>
                    </a>

                    <!-- Tài khoản / Đăng nhập -->
                    @if (Context.Session.GetString("TenDangNhap") != null)
                    {
                        <div class="dropdown">
                            <button class="btn-tai-khoan dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle fs-5"></i>
                                <span class="text-truncate" style="max-width: 100px;">@Context.Session.GetString("TenDangNhap")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item fw-semibold" href="/Home/Index"><i class="fas fa-gauge me-2 text-primary"></i>Giao Diện Hệ Thống</a></li>
                                <li><a class="dropdown-item fw-semibold" href="/Profile/Index"><i class="fas fa-user-gear me-2 text-info"></i>Trang Cá Nhân</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item fw-semibold text-danger" href="/Login/DangXuat"><i class="fas fa-right-from-bracket me-2"></i>Đăng Xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="btn-tai-khoan dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user"></i> Tài Khoản
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item fw-semibold" href="/Login"><i class="fas fa-right-to-bracket me-2 text-warning"></i>Đăng Nhập</a></li>
                                <li><a class="dropdown-item fw-semibold" href="/Login/DangKy"><i class="fas fa-user-plus me-2 text-success"></i>Đăng Ký</a></li>
                            </ul>
                        </div>
                    }
                </div>

            </div>
        </div>
    </header>

    <!-- OFFCANVAS MOBILE MENU -->
    <div class="offcanvas offcanvas-end offcanvas-menu" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title serif-title text-white" id="mobileMenuLabel">Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <a href="/Home/Welcome#trang-chu" class="mobile-nav-link" data-bs-dismiss="offcanvas">Trang Chủ</a>
            <a href="/Home/Welcome#ve-tram" class="mobile-nav-link" data-bs-dismiss="offcanvas">Về Trạm</a>
            <a href="/Home/Welcome#thu-cung" class="mobile-nav-link" data-bs-dismiss="offcanvas">Thú Cưng</a>
            <a href="/Home/TinTuc" class="mobile-nav-link active" data-bs-dismiss="offcanvas">Tin Tức & Tạp Chí</a>
            <a href="/Home/Welcome#quyen-gop" class="mobile-nav-link" data-bs-dismiss="offcanvas">Quyên Góp</a>
